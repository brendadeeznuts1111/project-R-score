# Root environment template — resolved via Proton Pass
# Usage:   pass-cli inject env.template --output .env
# Verify:  bun run proton:verify
# Requires: source scripts/agent-env.sh factorywager (or pass-cli login)
#
# ── Key naming conventions ─────────────────────────────────────────────────
#   {DOMAIN}_{SCOPE}_{ROLE}   e.g.  CLOUDFLARE_API_TOKEN
#   {DOMAIN}_SECRET           for symmetric/validation secrets
#   {DOMAIN}_KEY              for asymmetric/SSH keys
#   {DOMAIN}_PAT              for Personal Access Tokens
#
# ── Vault ref patterns ────────────────────────────────────────────────────
#   Active:    KEY={{ pass://factorywager/Item Name/field }}
#   Document:  # KEY={{ pass://factorywager/Item Name/field }}  (commented = not yet wired)
#   Deprecated: drop from template after migration
#
# ── Display chrome (label / color / icon) ───────────────────────────────────
#   Optional UI metadata: config/vault-map.toml (envMap[KEY]; type: "toml").
#   Machine paths stay here (pass://); labels/colors never change env names.
#   CLI: bun run portal:secret map | portal secret autofill (colored status)
#   Bake: bun run env:inventory:bake → /registry/vault-map.json

# ═══════════════════════════════════════════════════════════════════════════
# R2 / Object Storage
# ═══════════════════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
R2_ACCESS_KEY_ID={{ pass://factorywager/R2 bun-secrets bucket/username }}
R2_SECRET_ACCESS_KEY={{ pass://factorywager/R2 bun-secrets bucket/password }}
R2_BUCKET_NAME=bun-secrets

# ═══════════════════════════════════════════════════════════════════════════
# Registry / API Tokens
# ═══════════════════════════════════════════════════════════════════════════
# FactoryWager registry token for package publish/auth (scoped @factorywager)
FACTORY_WAGER_TOKEN={{ pass://factorywager/FactoryWager Registry Token/password }}
# Registry dev secret — local dev signature verification
REGISTRY_SECRET={{ pass://factorywager/Registry Dev Secret/password }}

# ═══════════════════════════════════════════════════════════════════════════
# Cloudflare
# ═══════════════════════════════════════════════════════════════════════════
# Pages/API token — NO Zone.DNS scope (use CLOUDFLARE_DNS_API_TOKEN for DNS)
CLOUDFLARE_API_TOKEN={{ pass://factorywager/Cloudflare API Token/password }}
# Separate narrower token with Zone.DNS:Read/Edit; same vault, separate item
CLOUDFLARE_DNS_API_TOKEN={{ pass://factorywager/Cloudflare API Token (DNS)/password }}
CLOUDFLARE_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36

# ═══════════════════════════════════════════════════════════════════════════
# Telegram
# ═══════════════════════════════════════════════════════════════════════════
# Bot token for factory-wager ops bot (factorywager vault — bot cannot see tenants)
TELEGRAM_BOT_FACTORY={{ pass://factorywager/Telegram: factorywager_bot/password }}
# Webhook secret for Telegram callback verification
TELEGRAM_WEBHOOK_SECRET={{ pass://factorywager/Telegram Webhook Secret/password }}
TELEGRAM_OPS_CHAT_ID=neg-1003937534779

# ═══════════════════════════════════════════════════════════════════════════
# Ops Signing
# ═══════════════════════════════════════════════════════════════════════════
# Play HMAC signing (PlaySigner — lib/security/play-signer.ts)
PLAY_SIGNING_SECRET={{ pass://factorywager/Play Signing Secret/password }}
# Board/deep-audit HMAC (lib/security/report-proof.ts)
REPORT_SIGNING_SECRET={{ pass://factorywager/Report Signing Secret/password }}

# ═══════════════════════════════════════════════════════════════════════════
# DOD / Identity / Provisioning
# ═══════════════════════════════════════════════════════════════════════════
# Delegated Origination Document proof secret
DOD_PROOF_SECRET={{ pass://factorywager/DOD Proof Secret/password }}
# DOD ID encryption key
DOD_ID_ENCRYPTION_KEY={{ pass://factorywager/DOD ID Encryption Key/password }}
# Provisioning encryption key for account credentials
PROVISION_ENCRYPTION_KEY={{ pass://factorywager/Provision Encryption Key/password }}

# ═══════════════════════════════════════════════════════════════════════════
# SSH Keys
# ═══════════════════════════════════════════════════════════════════════════
# SSH private key for git operations (deploy keys, GitHub Actions)
# Wire via: pass-cli run -- bun run deploy
# SSH_PKEY_PATH=~/.ssh/pass-decrypted
# SSH_PKEY={{ pass://factorywager/SSH Deploy Key/note }}
#
# SSH deploy key for cascade-mover remote (separate keypair)
# CASCADE_SSH_PKEY={{ pass://factorywager/SSH Cascade Key/note }}

# ═══════════════════════════════════════════════════════════════════════════
# Personal Access Tokens (PAT)
# ═══════════════════════════════════════════════════════════════════════════
# GitHub PAT — used for CI, registry publish, and git operations
# Push via: GITHUB_TOKEN={{ pass://factorywager/GitHub PAT/note }}
# Scope: repo, write:packages, read:org
#
# Cloudflare API PAT — alternative to CLOUDFLARE_API_TOKEN (shorter-lived)
# CF_API_PAT={{ pass://factorywager/Cloudflare PAT/password }}
#
# NPM publish token (for @factorywager scoped packages)
# NPM_TOKEN={{ pass://factorywager/NPM Publish Token/password }}

# ═══════════════════════════════════════════════════════════════════════════
# Redis / Caching
# ═══════════════════════════════════════════════════════════════════════════
# Non-secret default; set for shared multi-host Redis. Vault item optional.
REDIS_URL=redis://localhost:6379
# When vaulted: REDIS_URL={{ pass://factorywager/Redis URL/password }}

# ═══════════════════════════════════════════════════════════════════════════
# Environment Defaults
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=production
MCP_LOG_LEVEL=info
BUN_CONSOLE_DEPTH=4

# ═══════════════════════════════════════════════════════════════════════════
# Compliance Portal
# ═══════════════════════════════════════════════════════════════════════════
# Optional remote mock for shadow bake
# COMPLIANCE_URL=http://127.0.0.1:8787
# COMPLIANCE_MOCK_PORT=8787 — mock SERVER listen port
# Deploy token is vaulted CLOUDFLARE_API_TOKEN (above).

# ═══════════════════════════════════════════════════════════════════════════
# Vault Backlog / Gap Tracking
# ═══════════════════════════════════════════════════════════════════════════
# Ratchet items (human only — must be vaulted manually):
#   OPENAI_API_KEY | SLACK_WEBHOOK_URL
# Runtime-mintable (local generation OK):
#   DOD_* | PROVISION_ENCRYPTION_KEY | PLAY_SIGNING_SECRET | REPORT_SIGNING_SECRET
# Export mint → Pass: bun run vault:gap:export-minted  then vault:gap:wire
#
# Alias map:
#   TELEGRAM_BOT_TOKEN → TELEGRAM_BOT_FACTORY
#   API_KEY → FACTORY_WAGER_TOKEN
#   TELEGRAM_CATALOG_RESEARCH_LLM_KEY → OPENAI_API_KEY
#
# LLM triple (distinct knobs):
#   LLM_KEY = API key · LLM_MODEL = model name · LLM_URL = OpenAI-compatible base URL
