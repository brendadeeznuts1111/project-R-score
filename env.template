# ═══════════════════════════════════════════════════════════════════════════
# SSH Keys
# ═══════════════════════════════════════════════════════════════════════════
# SSH private key for git operations (deploy keys, GitHub Actions)
# Wire via: pass-cli run -- bun run deploy
# SSH_PKEY_PATH=~/.ssh/pass-decrypted
# SSH_PKEY={{ pass-ref:factorywager/SSH Deploy Key/note }}
#
# SSH deploy key for cascade-mover remote (separate keypair)
# CASCADE_SSH_PKEY={{ pass-ref:factorywager/SSH Cascade Key/note }}

# ═══════════════════════════════════════════════════════════════════════════
# Supply chain / Security scanners
# ═══════════════════════════════════════════════════════════════════════════
# Socket Security — optional auth for @socketsecurity/bun-security-scanner
# Scope: packages:list (API rejects token with 401 without it).
# Free mode (key unset) uses public firewall API — OK for rare on-demand scans.
# Do NOT leave SOCKET_API_KEY in .env for day-to-day: prefer free mode + cooldown.
# Install-time scanner is OFF in bunfig by default (quota). On-demand:
#   bun run portal-cli scanner scan --oneshot --force
# Mint: https://socket.dev → API tokens → packages:list
# Vault item may hold a real token; inject only when intentionally using org mode.
SOCKET_API_KEY={{ pass://factorywager/Socket API Key/password }}

# ═══════════════════════════════════════════════════════════════════════════
# Personal Access Tokens (PAT)
# ═══════════════════════════════════════════════════════════════════════════
# GitHub PAT — used for CI, registry publish, and git operations
# Push via: GITHUB_TOKEN={{ pass-ref:factorywager/GitHub PAT/note }}
# Scope: repo, write:packages, read:org
#
# Cloudflare API PAT — alternative to CLOUDFLARE_API_TOKEN (shorter-lived)
# CF_API_PAT={{ pass-ref:factorywager/Cloudflare PAT/password }}
#
# NPM publish token (for @factorywager scoped packages)
# NPM_TOKEN={{ pass-ref:factorywager/NPM Publish Token/password }}

# ═══════════════════════════════════════════════════════════════════════════
# Redis / Caching
# ═══════════════════════════════════════════════════════════════════════════
# Non-secret default; set for shared multi-host Redis. Vault item optional.
REDIS_URL=redis://localhost:6379
# When vaulted: REDIS_URL={{ pass-ref:factorywager/Redis URL/password }}

