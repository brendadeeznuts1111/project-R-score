# ═══════════════════════════════════════════════════════════════════════════
# Vault Backlog / Gap Tracking
# ═══════════════════════════════════════════════════════════════════════════
# Ratchet items (human only — must be vaulted manually):
#   OPENAI_API_KEY | SLACK_WEBHOOK_URL
# Runtime-mintable (local generation OK):
#   DOD_* | PROVISION_ENCRYPTION_KEY | PLAY_SIGNING_SECRET | REPORT_SIGNING_SECRET
# Export mint → Pass: bun run vault:gap:export-minted  then vault:gap:wire
#
# Alias map:
#   TELEGRAM_BOT_TOKEN → TELEGRAM_BOT_FACTORY
#   API_KEY → FACTORY_WAGER_TOKEN
#   TELEGRAM_CATALOG_RESEARCH_LLM_KEY → OPENAI_API_KEY
#
# LLM triple (distinct knobs):
#   LLM_KEY = API key · LLM_MODEL = model name · LLM_URL = OpenAI-compatible base URL

# ═══════════════════════════════════════════════════════════════════════════
# Concept Governance (non-secret operational toggles — CLI flags override)
# ═══════════════════════════════════════════════════════════════════════════
# concept:audit (scripts/concept-audit.ts)
# CONCEPT_AUDIT_STRICT=0            # 1 = fail on violations (CI gate)
# CONCEPT_AUDIT_QUIET=0             # 1 = suppress banner/summaries
# CONCEPT_AUDIT_OUTPUT=table        # table | json | markdown
# CONCEPT_AUDIT_FILTER=             # status filter (active | deprecated)
# CONCEPT_AUDIT_GROUP=              # csv id prefixes (ops.metric,ops.filter)
# CONCEPT_AUDIT_CATEGORY=           # glossary category
# CONCEPT_AUDIT_DOMAIN=             # csv domains (api,ops,page,section,ui)
# CONCEPT_AUDIT_DOMAIN_SUMMARY=0    # 1 = print domain rollup tile
# CONCEPT_AUDIT_BOARD=              # partner-history | partners | limits | account
# CONCEPT_AUDIT_SORT=               # id|label|domain|group|category|status|usage|provenance
# CONCEPT_AUDIT_DESC=0
# CONCEPT_AUDIT_SHOW_UNUSED=0 / CONCEPT_AUDIT_SHOW_USED=0
# CONCEPT_AUDIT_SHOW_DEPRECATED=0 / CONCEPT_AUDIT_SHOW_ORPHANS=0
# CONCEPT_AUDIT_MIN_USAGE=0 / CONCEPT_AUDIT_MAX_USAGE=9999
# CONCEPT_AUDIT_PROVENANCE=         # present | missing
# CONCEPT_AUDIT_OUTPUT_HEADERS=     # csv columns
# CONCEPT_AUDIT_WATCH_POLL=0 / CONCEPT_AUDIT_WATCH_DELAY_MS=200
# CONCEPT_AUDIT_VERBOSE=0
#
# concept:inventory (tools/concept-inventory.ts)
# CONCEPT_INVENTORY_OUTPUT=table    # table | json | markdown
# CONCEPT_INVENTORY_FILTER_GROUP=   # dotted id prefix
# CONCEPT_INVENTORY_FILTER_CATEGORY=
# CONCEPT_INVENTORY_FILTER_DOMAIN=  # api | ops | page | section | ui
# CONCEPT_INVENTORY_FILTER_STATUS=  # active | deprecated
# CONCEPT_INVENTORY_SHOW_UNUSED=0
# CONCEPT_INVENTORY_SORT=           # id | usage | group | domain
# CONCEPT_INVENTORY_DESC=0
#
# validate:concept-metadata (scripts/validate-concept-metadata.ts)
# CONCEPT_METADATA_STRICT=0         # 1 = also fail grandfathered ids missing addedAt
# CONCEPT_METADATA_FIX=0            # 1 = auto-repair domain + addedAt (never invents correlationId)
#
# Lifecycle (concept:propose / concept:review)
# CONCEPT_PROPOSE_PR=0              # 1 = open a draft PR on propose (requires gh)
# CONCEPT_REVIEWER=                 # default reviewer hint recorded on proposals
# CONCEPT_PROPOSAL_TEMPLATE=        # path to JSON template merged as proposal defaults
#
# concept:discover (scripts/concept-discover.ts)
# CONCEPT_DISCOVER_AUTO_PROPOSE=0   # 1 = queue discovered refs as pending proposals
# CONCEPT_DISCOVER_ACTOR=concept-discover  # actor recorded on auto-proposals
#
# Health (concept:health / concept:health:weekly)
# CONCEPT_HEALTH_PERIOD_DAYS=30     # lifecycle activity window
#
# Registry API (concept:serve — scripts/concept-serve.ts)
# CONCEPT_REGISTRY_PORT=3042        # 127.0.0.1 read-only concept registry API
