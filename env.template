# Root environment template — resolved via Proton Pass
# Usage:   pass-cli inject env.template --output .env
# Verify:  bun run proton:verify
# Requires: source scripts/agent-env.sh factorywager (or pass-cli login)
#
# ── Key naming conventions ─────────────────────────────────────────────────
#   {DOMAIN}_{SCOPE}_{ROLE}   e.g.  CLOUDFLARE_API_TOKEN
#   {DOMAIN}_SECRET           for symmetric/validation secrets
#   {DOMAIN}_KEY              for asymmetric/SSH keys
#   {DOMAIN}_PAT              for Personal Access Tokens
#
# ── Vault ref patterns ────────────────────────────────────────────────────
#   Active:    KEY={{ pass:<<vault/item/field>> }}   (pass-cli inject; use real pass:// URIs on KEY= lines only)
#   Document:  # KEY=…  (commented = not yet wired — never put live pass:// in comments; inject scans them)
#   Deprecated: drop from template after migration
#
# ── Display chrome (label / color / icon) ───────────────────────────────────
#   Optional UI metadata: config/vault-map.toml (envMap[KEY]; type: "toml").
#   Machine paths stay here (pass://); labels/colors never change env names.
#   CLI: bun run portal:secret map | portal secret autofill (colored status)
#   Bake: bun run env:inventory:bake → /registry/vault-map.json

# ═══════════════════════════════════════════════════════════════════════════
# R2 / Object Storage
# ═══════════════════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
R2_ACCESS_KEY_ID={{ pass://factorywager/R2 bun-secrets bucket/username }}
R2_SECRET_ACCESS_KEY={{ pass://factorywager/R2 bun-secrets bucket/password }}
R2_BUCKET_NAME=bun-secrets

# ═══════════════════════════════════════════════════════════════════════════
# Registry / API Tokens
# ═══════════════════════════════════════════════════════════════════════════
# FactoryWager registry token for package publish/auth (scoped @factorywager)
FACTORY_WAGER_TOKEN={{ pass://factorywager/FactoryWager Registry Token/password }}
# Registry dev secret — local dev signature verification
REGISTRY_SECRET={{ pass://factorywager/Registry Dev Secret/password }}

# ═══════════════════════════════════════════════════════════════════════════
# Cloudflare
# ═══════════════════════════════════════════════════════════════════════════
# Pages/API token — NO Zone.DNS scope (use CLOUDFLARE_DNS_API_TOKEN for DNS)
CLOUDFLARE_API_TOKEN={{ pass://factorywager/Cloudflare API Token/password }}
# Separate narrower token with Zone.DNS:Read/Edit; same vault, separate item
CLOUDFLARE_DNS_API_TOKEN={{ pass://factorywager/Cloudflare API Token (DNS)/password }}
# Access/ZT only (kimi-cloudflare-access plan/apply) — not the general Pages token
CLOUDFLARE_ACCESS_API_TOKEN={{ pass://factorywager/Cloudflare Access API Token/password }}
CLOUDFLARE_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36

# ═══════════════════════════════════════════════════════════════════════════
# Telegram
# ═══════════════════════════════════════════════════════════════════════════
# Bot token for factory-wager ops bot (factorywager vault — bot cannot see tenants)
TELEGRAM_BOT_FACTORY={{ pass://factorywager/Telegram: factorywager_bot/password }}
# Webhook secret for Telegram callback verification
TELEGRAM_WEBHOOK_SECRET={{ pass://factorywager/Telegram Webhook Secret/password }}
TELEGRAM_OPS_CHAT_ID=neg-1003937534779

# ═══════════════════════════════════════════════════════════════════════════
# Ops Signing
