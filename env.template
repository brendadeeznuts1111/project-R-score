# Root environment template — resolved via Proton Pass
# Usage: pass-cli inject env.template --output .env
# Requires: source scripts/agent-env.sh factorywager

# === R2 Storage ===
R2_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
R2_ACCESS_KEY_ID={{ pass://factorywager/R2 bun-secrets bucket/username }}
R2_SECRET_ACCESS_KEY={{ pass://factorywager/R2 bun-secrets bucket/password }}
R2_BUCKET_NAME=bun-secrets

# === FactoryWager Registry ===
FACTORY_WAGER_TOKEN={{ pass://factorywager/FactoryWager Registry Token/password }}
REGISTRY_SECRET={{ pass://factorywager/Registry Dev Secret/password }}

# === Cloudflare ===
CLOUDFLARE_API_TOKEN={{ pass://factorywager/Cloudflare API Token/password }}
# Narrower DNS-scoped token (optional consumers); same vault, separate item
CLOUDFLARE_DNS_API_TOKEN={{ pass://factorywager/Cloudflare API Token (DNS)/password }}
CLOUDFLARE_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36

# === Telegram (factorywager vault — agent factorywager-bot cannot see tenants) ===
TELEGRAM_BOT_FACTORY={{ pass://factorywager/Telegram: factorywager_bot/password }}
TELEGRAM_WEBHOOK_SECRET={{ pass://factorywager/Telegram Webhook Secret/password }}
TELEGRAM_OPS_CHAT_ID=neg-1003937534779

# === Environment ===
NODE_ENV=production
MCP_LOG_LEVEL=info
BUN_CONSOLE_DEPTH=4

# === Workspace packages (p2p / business Redis clients) ===
# Non-secret local default in code; set for shared Redis. Optional Pass item when multi-host.
REDIS_URL=redis://localhost:6379
# When vaulted: REDIS_URL={{ pass://factorywager/Redis URL/password }}

# === Compliance portal (non-secret; optional remote mock for shadow bake) ===
# COMPLIANCE_URL=http://127.0.0.1:8787
# COMPLIANCE_MOCK_PORT=8787
# Deploy token remains vaulted CLOUDFLARE_API_TOKEN above (proton:inject).

# === Ops signing (mintable; multi-host → Proton Pass factorywager vault) ===
# PLAY_SIGNING_SECRET — play HMAC (PlaySigner)
# REPORT_SIGNING_SECRET — board/deep-audit HMAC (lib/security/report-proof.ts)
# Local: bun run vault:gap:mint-local
# Vault item (when wired): pass://factorywager/Report Signing Secret/password
#   REPORT_SIGNING_SECRET={{ pass://factorywager/Report Signing Secret/password }}
#   PLAY_SIGNING_SECRET={{ pass://factorywager/Play Signing Secret/password }}


# === Operator secrets (Proton Pass — vault-gap-close) ===
DOD_PROOF_SECRET={{ pass://factorywager/DOD Proof Secret/password }}
DOD_ID_ENCRYPTION_KEY={{ pass://factorywager/DOD ID Encryption Key/password }}
PROVISION_ENCRYPTION_KEY={{ pass://factorywager/Provision Encryption Key/password }}
PLAY_SIGNING_SECRET={{ pass://factorywager/Play Signing Secret/password }}
REPORT_SIGNING_SECRET={{ pass://factorywager/Report Signing Secret/password }}

# === Vault backlog (see bun run vault:gap:status) ===
# Ratchet (human only): OPENAI_API_KEY | SLACK_WEBHOOK_URL
# Runtime-mintable (local OK): DOD_* | PROVISION_ENCRYPTION_KEY | PLAY_SIGNING_SECRET | REPORT_SIGNING_SECRET
# Export mint → Pass: bun run vault:gap:export-minted  then vault:gap:wire
# Aliases: TELEGRAM_BOT_TOKEN→TELEGRAM_BOT_FACTORY, API_KEY→FACTORY_WAGER_TOKEN,
#   TELEGRAM_CATALOG_RESEARCH_LLM_KEY→OPENAI_API_KEY

