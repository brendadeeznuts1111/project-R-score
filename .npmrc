# FactoryWager npm read gateway (canonical)
# NOTE: scope→URL mapping SSOT for Bun is bunfig.toml [install.scopes];
# these npm-format lines remain for non-Bun tooling (vite/npm clients).
# The Pages endpoint is public/read-only, so never send a registry token to it.
@factorywager:registry=https://registry.factory-wager.com/api/npm
