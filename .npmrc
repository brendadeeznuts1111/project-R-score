# FactoryWager Private Registry (canonical)
# NOTE: scope→URL mapping SSOT for Bun is bunfig.toml [install.scopes];
# these npm-format lines remain for non-Bun tooling (vite/npm clients).
# Local dev override: bunfig.toml scopes point to http://localhost:3000/
@factory-wager:registry=http://localhost:3000/
@factorywager:registry=http://localhost:3000/
//localhost:3000/:_authToken=${FACTORY_WAGER_TOKEN}
//localhost:3000/:always-auth=true

# Cache + network defaults
cache=${HOME}/.npm
max-size=2GB
timeout=5000
retry-timeout=1000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
strict-ssl=true
loglevel=info
progress=true
save-exact=false
save-prefix=^
package-lock=true
package-lock-only=false
audit=true
audit-level=moderate
fund=true
