{
  "name": "@factorywager/registry-client",
  "version": "1.0.0",
  "description": "Runtime-neutral HTTP SDK for the FactoryWager artifact registry",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {},
  "peerDependencies": {
    "bun-types": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm && bunx tsc --project ./tsconfig.json",
    "test": "bun test ../../tests/registry-sdk.test.ts",
    "prepublishOnly": "bun run build"
  }
}
