{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "ignoreDeprecations": "6.0",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    // Empty on purpose: public .d.ts emit must not inject Bun globals into consumers.
    // App/scripts tsconfigs use "types": ["bun"] (tsconfig.base.json). TS 6+ requires explicit types.
    // @see https://bun.com/docs/typescript-6
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
