{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "incremental": true,
    "strict": true,
    "tsBuildInfoFile": "../../.cache/tsbuildinfo/packages-partners.tsbuildinfo"
