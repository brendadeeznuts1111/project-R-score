# 📦 NPM Registry Environment Variables
# Copy to .env.registry and fill in your values

# ============================================
# R2 Storage Configuration
# ============================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_REGISTRY_BUCKET=factory-wager-registry

# Optional: Custom R2 endpoint
# R2_ENDPOINT=https://custom.r2.cloudflarestorage.com

# ============================================
# Registry plane configuration
# ============================================
REGISTRY_PORT=4873
REGISTRY_HOST=0.0.0.0
FACTORY_WAGER_NPM_REGISTRY_URL=https://registry.factory-wager.com/api/npm
FACTORY_WAGER_REGISTRY_ORIGIN=https://registry.factory-wager.com
FACTORY_WAGER_LOCAL_REGISTRY_WRITE_URL=http://localhost:3000
FACTORY_WAGER_LOCAL_REGISTRY_TOKEN=replace_me

# These settings authorize the loopback development gateway only.
REGISTRY_AUTH=token
REGISTRY_SECRET=replace_me

# Multipart SDK publish limit (bytes; default 50 MiB)
REGISTRY_MAX_PUBLISH_BYTES=52428800

# ============================================
# CDN Configuration
# ============================================
REGISTRY_CDN_URL=https://registry.factory-wager.com

# ============================================
# Upstream Proxy Configuration
# ============================================
REGISTRY_PROXY=true
REGISTRY_UPSTREAM=https://registry.npmjs.org

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Monitoring Alerts (Optional)
# ============================================
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
