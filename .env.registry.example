# 📦 NPM Registry Environment Variables
# Copy to .env.registry and fill in your values

# ============================================
# R2 Storage Configuration
# ============================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_REGISTRY_BUCKET=npm-registry

# Optional: Custom R2 endpoint
# R2_ENDPOINT=https://custom.r2.cloudflarestorage.com

# ============================================
# Registry Server Configuration
# ============================================
REGISTRY_PORT=4873
REGISTRY_HOST=0.0.0.0
REGISTRY_URL=https://registry.factory-wager.com
REGISTRY_PUBLIC_URL=https://registry.factory-wager.com

# Production must use token or jwt. `none` is local-development only.
REGISTRY_AUTH=token

# Shared bearer secret for the Bun publish gateway
REGISTRY_SECRET=replace_me

# Multipart SDK publish limit (bytes; default 50 MiB)
REGISTRY_MAX_PUBLISH_BYTES=52428800

# ============================================
# CDN Configuration
# ============================================
REGISTRY_CDN_URL=https://npm.factory-wager.com

# ============================================
# Upstream Proxy Configuration
# ============================================
REGISTRY_PROXY=true
REGISTRY_UPSTREAM=https://registry.npmjs.org

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Monitoring Alerts (Optional)
# ============================================
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
