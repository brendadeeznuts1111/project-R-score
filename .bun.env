# Reference only — Bun does NOT auto-load this file.
# Source manually if needed; prefer ~/.bunfig.toml for install policy.
#
# Bun HTTP tuning: https://bun.com/docs/runtime/networking/fetch

BUN_CONFIG_MAX_HTTP_REQUESTS=512
BUN_CONFIG_MAX_HTTP_REQUESTS_PER_HOST=6
BUN_FEATURE_FLAG_DISABLE_NATIVE_DEPENDENCY_LINKER=0
BUN_FEATURE_FLAG_DISABLE_IGNORE_SCRIPTS=0
NODE_OPTIONS="--max-old-space-size=1024"