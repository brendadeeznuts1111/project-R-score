    },
    {
      "utility": "deepEquals",
      "input": "[1,2] == [1,2]",
      "expected": true,
      "actual": true,
      "note": "Same array",
      "pass": true
    },
    {
      "utility": "deepEquals",
      "input": "[1,2] == [1,3]",
      "expected": false,
      "actual": false,
      "note": "Different array",
      "pass": true
    },
    {
      "utility": "deepEquals(strict)",
      "input": "{a:1} == {a:1,extra:undefined}",
      "expected": false,
      "actual": false,
      "note": "Strict: extra undefined key",
      "pass": true
    },
    {
      "utility": "deepEquals(strict)",
      "input": "[\"a\"] == [\"a\",undefined]",
