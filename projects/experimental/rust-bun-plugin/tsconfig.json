{
  "compilerOptions": {
    "types": ["bun"],
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "node",
    "module": "CommonJS",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [
      "bun"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "bench",
    "__test__"
  ]
}
