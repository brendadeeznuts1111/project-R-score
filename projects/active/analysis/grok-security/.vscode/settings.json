{
  // [0.0.0.0] FACTORY WAGER - Bun v1.3.5+ Workspace Settings
  // Zero-npm, Prettier 80-char, dark-mode-first development
  // Enhanced with RSS Feed Table, URLPattern, DNS Resolver support

  // [1.0.0.0] EDITOR SETTINGS
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 120],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 80,
  "editor.fontSize": 12,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "editor.lineHeight": 1.6,

  // [1.1.0.0] TYPESCRIPT/BUN SETTINGS
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.quoteStyle": "double",
  "typescript.suggest.autoImports": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.variableTypes.enabled": true,

  // [1.2.0.0] PRETTIER FORMATTING
  "prettier.printWidth": 80,
  "prettier.semi": true,
  "prettier.singleQuote": false,
  "prettier.trailingComma": "es5",
  "prettier.bracketSpacing": true,

  // [2.0.0.0] FILE ASSOCIATIONS
  "files.associations": {
    "*.ts": "typescript",
    "*.tsx": "typescriptreact",
    "bunfig.toml": "toml",
    "*.md": "markdown"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": false,
    "**/.git": true,
    "**/.DS_Store": true
  },

  // [2.1.0.0] SEARCH SETTINGS
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/*.lock": true,
    "**/build": true
  },

  // [3.0.0.0] TERMINAL SETTINGS
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.osx": {
    "BUN_ENV": "development",
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
  },
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.lineHeight": 1.4,

  // [4.0.0.0] EXTENSION RECOMMENDATIONS
  "editor.quickSuggestions": {
    "strings": true,
    "comments": true
  },

  // [4.1.0.0] SNIPPET BEHAVIOR
  "editor.snippetSuggestions": "top",
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggest.showStatusBar": true,

  // [5.0.0.0] THEME & APPEARANCE
  "workbench.colorTheme": "One Dark Pro",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.showTabs": "multiple",

  // [6.0.0.0] DEBUGGING
  "debug.console.fontSize": 12,
  "debug.console.lineHeight": 1.4,

  // [7.0.0.0] EXPLORER SETTINGS
  "explorer.compactFolders": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true
}
