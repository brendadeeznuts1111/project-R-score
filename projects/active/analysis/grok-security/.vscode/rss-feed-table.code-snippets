{
  // [0.0.0.0] RSS FEED TABLE SNIPPETS - Bun v1.3.5+ Enterprise Patterns
  // Institutional-grade tabular rendering for Bun RSS feeds
  // Factory Wager monorepo [DOMAIN][SCOPE][META]{BUN-API-#REF}

  // [1.0.0.0] CORE RSS FEED TABLE OPERATIONS
  "RSS Feed Entry": {
    "prefix": ["rssentry", "feedentry"],
    "body": [
      "const entry: RSSFeedEntry = {",
      "  title: '${1:Article Title}',",
      "  feedType: '${2|Blog Release,Blog Tutorial,Blog Guide,Blog Case|}',",
      "  entryDate: '${3:2025-12-17T00:00:00Z}',",
      "  authorRef: '${4:Author Name}',",
      "  summaryLength: '${5:1200} chars',",
      "  tags: '${6:release,features,performance}',",
      "  timestamp: new Date().toISOString(),",
      "  owner: '${7:maintainer.author.name}',",
      "  metrics: '${8:Performance impact notes}',",
      "};",
    ],
    "description": "[1.1.0.0] RSSFeedEntry interface with all required fields",
  },

  "Render RSS Table ASCII": {
    "prefix": ["rssascii", "rendertable"],
    "body": [
      "// [${1:1.x.x.x}] Render RSS feed as ASCII table",
      "import { RSSTableUtils } from './src/core/rss-table-integration';",
      "",
      "const entries: RSSFeedEntry[] = ${2:[...]};",
      "const ascii = RSSTableUtils.render(entries, 'ascii');",
      "console.log(ascii);",
    ],
    "description": "[1.2.0.0] RSSTableUtils.render ASCII format",
  },

  "Validate and Render RSS": {
    "prefix": ["rssvalidate", "validaterender"],
    "body": [
      "// [${1:1.x.x.x}] Validate and render RSS entries",
      "import { RSSTableUtils } from './src/core/rss-table-integration';",
      "",
      "const result = RSSTableUtils.validateAndRender(${2:entries}, '${3|ascii,json,csv,html|}');",
      "if (result.valid) {",
      "  console.log(result.output);",
      "} else {",
      "  console.error('Validation errors:', result.errors);",
      "}",
    ],
    "description": "[1.3.0.0] RSSTableUtils.validateAndRender with error handling",
  },

  "RSS Feed Validator": {
    "prefix": ["rssvalidator", "feedvalidator"],
    "body": [
      "// [${1:1.x.x.x}] Validate RSS feed entries",
      "import { RSSFeedTableValidator } from './src/core/rss-feed-schema';",
      "",
      "const validator = new RSSFeedTableValidator({ minColumns: ${2:6} });",
      "const result = validator.validateEntries(${3:entries});",
      "",
      "console.log(`Valid: ${result.validEntries}/${result.totalEntries}`);",
      "if (!result.valid) {",
      "  result.invalidEntries.forEach(inv => {",
      "    console.error(`Entry ${inv.index}:`, inv.errors);",
      "  });",
      "}",
    ],
    "description": "[1.4.0.0] RSSFeedTableValidator with comprehensive validation",
  },

  "RSS Feed Enricher": {
    "prefix": ["rssenricher", "feedenricher"],
    "body": [
      "// [${1:1.x.x.x}] Enrich RSS entries with computed metrics",
      "import { RSSFeedTableEnricher } from './src/core/rss-feed-schema';",
      "",
      "const enricher = new RSSFeedTableEnricher();",
      "const enriched = enricher.enrichEntries(${2:entries});",
      "",
      "enriched.forEach(entry => {",
      "  console.log(`${entry.title}`);",
      "  console.log(`  Metrics: ${entry.metrics}`);",
      "});",
    ],
    "description": "[1.5.0.0] RSSFeedTableEnricher with automatic metric computation",
  },

  // [2.0.0.0] EXPORT OPERATIONS
  "Export RSS as JSON": {
    "prefix": ["rssjson", "exportjson"],
    "body": [
      "// [${1:2.x.x.x}] Export RSS entries as JSON",
      "import { RSSTableUtils } from './src/core/rss-table-integration';",
      "",
      "const entries: RSSFeedEntry[] = ${2:[...]};",
      "const json = RSSTableUtils.render(entries, 'json');",
      "await Bun.write('${3:feed.json}', json);",
      "console.log('✅ Exported: ${3:feed.json}');",
    ],
    "description": "[2.1.0.0] Export RSS entries as JSON file",
  },

  "Export RSS as CSV": {
