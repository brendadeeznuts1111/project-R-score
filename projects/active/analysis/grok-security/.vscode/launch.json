{
  // [0.0.0.0] VSCODE DEBUG CONFIGURATION - Factory Wager Bun v1.3.5+
  // Debugging configurations for Bun runtime, tests, and examples
  // Zero-npm, RSS Feed Table, URLPattern, DNS Resolver, Token Matcher

  "version": "0.2.0",
  "configurations": [
    // [1.0.0.0] BUN RUNTIME DEBUGGING
    {
      "name": "[1.1.0.0] Bun: Current File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}"
    },

    // [1.1.0.0] BUN TEST DEBUGGING
    {
      "name": "[1.2.0.0] Bun: Test Current File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["test", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    },

    // [2.0.0.0] RSS FEED TABLE DEBUGGING
    {
      "name": "[2.1.0.0] RSS: Feed Table Example",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["examples/rss-feed-table-example.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    {
      "name": "[2.2.0.0] RSS: Scraper Example",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["examples/rss-scraper-example.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    // [3.0.0.0] URLPATTERN DEBUGGING
    {
      "name": "[3.1.0.0] URLPattern: Example",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["examples/url-pattern-example.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    // [4.0.0.0] DNS RESOLVER DEBUGGING
    {
      "name": "[4.1.0.0] DNS: Resolver Example",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["examples/dns-resolver-example.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    // [5.0.0.0] TEST SUITE DEBUGGING
    {
      "name": "[5.1.0.0] Tests: RSS Feed Schema",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["test", "src/core/rss-feed-schema.test.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    {
      "name": "[5.2.0.0] Tests: RSS Table Integration",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["test", "src/core/rss-table-integration.test.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    {
      "name": "[5.3.0.0] Tests: All Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["test"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/bun-inspect-utils"
    },

    // [6.0.0.0] PERFORMANCE PROFILING
    {
      "name": "[6.1.0.0] Profile: Current File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["--profile", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    },

    // [7.0.0.0] ATTACH TO RUNNING PROCESS
    {
      "name": "[7.1.0.0] Attach to Bun Process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ],

  "compounds": [
    {
      "name": "[8.1.0.0] Full Test Suite",
      "configurations": [
        "[5.1.0.0] Tests: RSS Feed Schema",
        "[5.2.0.0] Tests: RSS Table Integration",
        "[5.3.0.0] Tests: All Tests"
      ]
    },

    {
      "name": "[8.2.0.0] All Examples",
      "configurations": [
        "[2.1.0.0] RSS: Feed Table Example",
        "[2.2.0.0] RSS: Scraper Example",
        "[3.1.0.0] URLPattern: Example",
        "[4.1.0.0] DNS: Resolver Example"
      ]
    }
  ]
}

