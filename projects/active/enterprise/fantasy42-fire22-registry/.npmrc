# Fire22 owns these scoped registry routes. Authentication remains scoped in
# bunfig.toml; npm-compatible callers may supply host-specific credentials in
# user or CI configuration without committing them here.
registry=https://registry.npmjs.org/
@fire22:registry=${FIRE22_REGISTRY_URL}
@enterprise:registry=${FIRE22_ENTERPRISE_REGISTRY_URL}
@private:registry=${FIRE22_PRIVATE_REGISTRY_URL}
