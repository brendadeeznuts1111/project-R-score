{
  "name": "ipfoxy-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "IPFoxy Proxy Management Dashboard",
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./index.html",
    "build": "bun build ./index.html --outdir=dist --target=browser --minify --sourcemap=linked",
    "preview": "bun ./dist/index.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "serve": "bun cli.ts serve 3000",
    "serve:3000": "bun cli.ts serve 3000",
    "serve:8080": "bun cli.ts serve 8080",
    "serve:8081": "bun cli.ts serve 8081",
    "benchmark": "bun cli.ts benchmark",
    "cli": "bun cli.ts help",
    "deploy": "bun deploy-to-r2.ts",
    "deploy:r2": "bun run build && bun deploy-to-r2.ts",
    "deploy:dev": "bun run build && bun deploy-to-r2.ts --dev",
    "deploy:staging": "bun run build && bun deploy-to-r2.ts --staging",
    "deploy:prod": "bun run build && bun deploy-to-r2.ts --prod",
    "r2-manage": "bun r2-cli.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "lucide-react": "0.263.1",
    "clsx": "1.2.1",
    "recharts": "3.10.1",
    "date-fns": "2.30.0",
    "axios": "1.19.0",
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/s3-request-presigner": "3.1112.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/bun": "1.4.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/ui": "4.1.10",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "bundledDependencies": [
    "react",
    "react-dom",
    "react-router-dom",
    "lucide-react",
    "clsx",
    "recharts",
    "date-fns",
    "axios",
    "@aws-sdk/client-s3",
    "@aws-sdk/s3-request-presigner"
  ]
}
