# Bootstrap only. The relay copies these into Bun.secrets
# (service com.factorywager.sports-ops) and then reads them from the OS keyring.
# Copy to demos/.sports-ops/session.env (gitignored, mode 600).
# Never commit real passwords. 4codds stays SIGN IN until FOURC_PASSWORD is stored.
F402_USER=
F402_PASSWORD=
FOURC_EMAIL=
FOURC_PASSWORD=
SPORTS_OPS_PORT=8787
CHROME_PATH=/opt/google/chrome/chrome
