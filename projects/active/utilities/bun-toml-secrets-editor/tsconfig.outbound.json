{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@bun-toml/core": ["packages/core/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "src/http/configured-outbound.ts",
    "src/http/storage-outbound.ts",
    "src/utils/response-buffering.ts",
    "src/tests/response-buffering.test.ts",
    "packages/rss/src/rss-fetcher.ts",
    "packages/rss/src/rss-feed-monitor.ts",
    "packages/rss/src/integration.test.ts",
    "tests/configured-outbound.test.ts",
    "tests/storage-outbound.test.ts"
  ]
}
