{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: dev",
      "type": "shell",
      "command": "bun run dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "bun: test",
      "type": "shell",
      "command": "bun test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "test"
    },
    {
      "label": "bun: typecheck",
      "type": "shell",
      "command": "bun run typecheck",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "bun: lint",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": "$eslint-stylish",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "bun: build",
      "type": "shell",
      "command": "bun run build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "bun: kyc-failsafe",
      "type": "shell",
      "command": "bun run cli/admin.ts --kyc-failsafe ${input:userId}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "userId",
      "type": "promptString",
      "description": "Enter user ID for KYC failsafe",
      "default": "test-user-123"
    }
  ]
}
