# Copy to .env for local deploys. Do not commit real secrets.

# Cloudflare Pages
PAGES_PROJECT_NAME=offshore-books-web
PAGES_BRANCH=main

# Cloudflare Worker wrangler.toml should also be updated with these public URLs.
ACCOUNTS_JSON_URL=https://offshore-books-web.pages.dev/accounts.sample.json
MINI_APP_URL=https://offshore-books-web.pages.dev/miniapp.html
BOT_USERNAME=your_bot_username
BALANCE_RECENT_HOURS=168

# Telegram bootstrap
TELEGRAM_BOT_TOKEN=123456:replace-me
WORKER_WEBHOOK_URL=https://offshore-books-bot.your-subdomain.workers.dev/telegram/webhook

# Optional Telegram Mini App deep-link base.
# MINI_APP_DEEP_LINK_BASE=https://t.me/your_bot_username
