{
  "_meta": {
    "version": "2.2.0",
    "updated": "2026-07-27",
    "syncWith": ".cursor/mcp.json (symlink to this file)",
    "docs": "https://cursor.com/docs/context/mcp",
    "notes": "SSOT for workspace MCP servers. Bun-native launch: command bun + script path (no run). Essential: dx + bun-docs. .vscode/mcp.json is generated: bun run mcp:sync (auto-regenerated by pre-commit when this file is staged)",
    "serverCatalog": {
      "essential": [
        "dx",
        "bun-docs"
      ],
      "domain": [
        "cascade-mover"
      ],
      "optional": [
        "ast-grep",
        "github",
        "cloudflare",
        "cloudflare-docs",
        "cloudflare-bindings",
        "cloudflare-builds",
        "cloudflare-observability"
      ],
      "requiresEnv": {
        "cascade-mover": [
          "projects/active/enterprise/cascade-mover-v3/.env"
        ]
      }
    }
  },
  "mcpServers": {
    "bun-docs": {
      "type": "stdio",
      "description": "Bun docs MCP v1.3 \u2014 lazy index, compact output, blog/RSS, rg query (zero npm deps)",
      "command": "bun",
      "args": [
        "/Users/nolarose/Projects/tools/bun-docs-mcp.ts"
      ],
      "env": {
        "BUN_DOCS_ROOT": "/Users/nolarose/Projects"
      }
    },
    "dx": {
      "type": "stdio",
      "description": "Developer Experience \u2014 project scan, health, README, Bun probes, mcp_status",
      "command": "bun",
      "args": [
        "/Users/nolarose/Projects/scripts/dx-mcp.ts"
      ],
      "env": {
        "DX_SCAN_ROOTS": "projects/active,projects/experimental,projects/archive,projects/active/enterprise/cascade-mover-v3,projects/active/enterprise/bet-ticker-worker-v1.1,packages,lib,tools"
      },
      "envFile": "/Users/nolarose/Projects/.env"
    },
    "cascade-mover": {
      "type": "stdio",
      "description": "Cascade Mover v3 \u2014 sports intelligence (lines, sources, confidence, 43 tools)",
      "command": "bun",
      "args": [
        "/Users/nolarose/Projects/projects/active/enterprise/cascade-mover-v3/src/server/cascade-mover-mcp.ts"
      ],
      "env": {
        "NODE_ENV": "production"
      },
      "envFile": "/Users/nolarose/Projects/projects/active/enterprise/cascade-mover-v3/.env"
    },
    "ast-grep": {
      "type": "stdio",
      "description": "ast-grep 0.44+ \u2014 outline, structural search, map, scan (pi-ast-grep parity)",
      "command": "bun",
      "args": [
        "/Users/nolarose/Projects/.agents/skills/ast-grep/mcp/ast-grep-mcp.ts"
      ],
      "env": {
        "AST_GREP_REPO_ROOT": "/Users/nolarose/Projects"
      }
    },
    "github": {
      "type": "stdio",
      "description": "Official GitHub MCP (local binary; PAT via gh auth token; git remotes remain SSH)",
      "command": "/Users/nolarose/Projects/scripts/github-mcp-stdio.sh"
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-bindings": {
      "type": "http",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-builds": {
      "type": "http",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "cloudflare-observability": {
      "type": "http",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    }
  }
}
