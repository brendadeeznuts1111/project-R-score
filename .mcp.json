{
  "_meta": {
    "version": "2.2.0",
    "updated": "2026-05-29",
    "syncWith": ".cursor/mcp.json",
    "docs": "https://cursor.com/docs/context/mcp",
    "notes": "Bun-native launch: command bun + script path (no run). Essential: dx + bun-docs.",
    "serverCatalog": {
      "essential": [
        "dx",
        "bun-docs"
      ],
      "remote": [
        "bun-docs-http"
      ],
      "domain": [
        "cascade-mover"
      ],
      "optional": [
        "app-security",
        "factorywager-tools",
        "mcp-bridge"
      ],
      "requiresEnv": {
        "factorywager-tools": [
          "R2_AUDIT_BUCKET"
        ],
        "cascade-mover": [
          "cascade-mover-v3/.env"
        ],
        "mcp-bridge": [
          ".env"
        ]
      }
    }
  },
  "mcpServers": {
    "bun-docs": {
      "type": "stdio",
      "description": "Bun docs MCP v1.3 — lazy index, compact output, blog/RSS, rg query (zero npm deps)",
      "command": "bun",
      "args": [
        "${workspaceFolder}/tools/bun-docs-mcp.ts"
      ],
      "env": {
        "BUN_DOCS_ROOT": "${workspaceFolder}"
      }
    },
    "bun-docs-http": {
      "type": "sse",
      "description": "Official Bun documentation MCP (remote fallback when local bun-docs unavailable)",
      "url": "https://bun.com/docs/mcp",
      "disabled": true
    },
    "dx": {
      "type": "stdio",
      "description": "Developer Experience \u2014 project scan, health, README, Bun probes, mcp_status",
      "command": "bun",
      "args": [
        "${workspaceFolder}/scripts/dx-mcp.ts"
      ],
      "env": {
        "DX_SCAN_ROOTS": "projects/active,projects/experimental,projects/archive,cascade-mover-v3,bet-ticker-worker-v1.1,packages,lib,tools"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "cascade-mover": {
      "type": "stdio",
      "description": "Cascade Mover v3 \u2014 sports intelligence (lines, sources, confidence, 43 tools)",
      "command": "bun",
      "args": [
        "${workspaceFolder}/cascade-mover-v3/src/server/cascade-mover-mcp.ts"
      ],
      "env": {
        "NODE_ENV": "production"
      },
      "envFile": "${workspaceFolder}/cascade-mover-v3/.env"
    },
    "app-security": {
      "type": "stdio",
      "description": "Secrets, password hashing, auth, deployment audit (Bun.secrets; disable if unused)",
      "command": "bun",
      "args": [
        "${workspaceFolder}/lib/security/mcp-server.ts"
      ],
      "env": {
        "BUN_RUNTIME": "true",
        "NODE_ENV": "production"
      },
      "envFile": "${workspaceFolder}/.env",
      "disabled": true
    },
    "factorywager-tools": {
      "type": "stdio",
      "description": "R2 audit, profiling, security scans (requires R2 env; disable if unused)",
      "command": "bun",
      "args": [
        "${workspaceFolder}/scripts/fw-tools-mcp.ts"
      ],
      "env": {
        "FW_COLORS_ENABLED": "true",
        "R2_AUDIT_BUCKET": "${env:R2_AUDIT_BUCKET}"
      },
      "envFile": "${workspaceFolder}/.env",
      "disabled": true
    },
    "mcp-bridge": {
      "type": "stdio",
      "description": "FactoryWager MCP bridge \u2014 SearchBunEnhanced, AuditSearch, wiki generation (Claude Desktop parity)",
      "command": "bun",
      "args": [
        "${workspaceFolder}/scripts/mcp-bridge.ts"
      ],
      "env": {
        "FW_COLORS_ENABLED": "true",
        "NODE_ENV": "production"
      },
      "envFile": "${workspaceFolder}/.env",
      "disabled": true
    }
  }
}
