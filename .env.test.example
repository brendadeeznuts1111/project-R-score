# .env.test.example — Bun test environment template
#
# Bun loads `.env.test` automatically when running `bun test` (and when
# NODE_ENV=test). Copy to `.env.test` for local overrides; that file is
# gitignored.
#
# @see https://bun.com/docs/test/configuration#environment-variables
# @see https://bun.com/docs/runtime/environment-variables#configuring-bun
# @see tests/preload.ts — coerces production → test for vault/partner fail-closed
# @see scripts/bun-test-changed-staged.ts — testRunEnv() sets the hook/scratch contract

# Required for Bun's test env file selection + preload contract
NODE_ENV=test

# Bun intermediate assets (optional — platform /tmp used when unset)
# TMPDIR=/tmp

# Disable bun.report crash uploads during local test loops (optional)
# DO_NOT_TRACK=1

# ANSI control (optional — Bun also honors TTY/pipe)
# NO_COLOR=1
# FORCE_COLOR=1

# Do NOT set these — Bun forges them under `bun test --parallel`:
#   BUN_TEST_WORKER_ID
#   JEST_WORKER_ID
#
# Do NOT leave BUN_OPTIONS set in the shell when debugging hooks — it prepends
# CLI args to every Bun invocation (e.g. --hot) and breaks hermetic test runs.
