{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorywager.com/schemas/skill-rating-evidence.schema.json",
  "title": "Project R dynamic skill-rating evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "model",
    "minimumOverallScore",
    "weights",
    "prior",
    "confidenceScale",
    "proofs"
  ],
  "properties": {
    "$schema": { "const": "./schemas/skill-rating-evidence.schema.json" },
    "schemaVersion": { "const": 1 },
    "model": { "const": "finite-evidence-v2" },
    "minimumOverallScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compliance", "structure", "evidence"],
      "properties": {
        "compliance": { "type": "number", "minimum": 0, "maximum": 1 },
        "structure": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha", "beta"],
      "properties": {
        "alpha": { "type": "number", "exclusiveMinimum": 0 },
        "beta": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "confidenceScale": { "type": "number", "exclusiveMinimum": 0 },
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "attribution", "command", "timeoutMs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "dimension": {
            "enum": ["model", "structure", "runtime", "contract"]
          },
          "attribution": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": { "kind": { "const": "portfolio" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": { "kind": { "const": "active-skills" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "names"],
                "properties": {
                  "kind": { "const": "skills" },
                  "names": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                  }
                }
              }
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 }
        }
      }
    }
  }
}
