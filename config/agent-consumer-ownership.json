{
  "schema": "factorywager.agent-consumer-ownership.v1",
  "profiles": {
    "authorized-manifest": {
      "executable": "manifest-bound",
      "args": "invocation-wire-bound",
      "cwd": "repository-bound",
      "environment": "allowlisted-no-ambient-authority",
      "stdio": "entrypoint-owned",
      "network": "manifest-route-bound",
      "offline": "invocation-policy-bound",
      "flagPassthrough": "control-policy-bound",
      "defaultDeny": true,
      "enforcement": "authorized"
    },
    "effect-free": {
      "executable": "not-applicable",
      "args": "application-only",
      "cwd": "not-applicable",
      "environment": "no-effect-authority",
      "stdio": "application-only",
      "network": "none",
      "offline": "not-applicable",
      "flagPassthrough": "none",
      "defaultDeny": true,
      "enforcement": "effect-free"
    },
    "unowned-gap": {
      "executable": "undeclared",
      "args": "undeclared",
      "cwd": "undeclared",
      "environment": "ambient-or-undeclared",
      "stdio": "undeclared",
      "network": "undeclared",
      "offline": "undeclared",
      "flagPassthrough": "implicit-gap",
      "defaultDeny": false,
      "enforcement": "unowned"
    }
  },
