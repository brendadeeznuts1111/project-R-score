// FactoryWager registry plane baseline (permanent repo config)
{
  read: {
    origin: "https://registry.factory-wager.com",
    npm: {
      url: "https://registry.factory-wager.com/api/npm",
      methods: ["GET", "HEAD"],
      authenticated: false,
    },
  },
  localWrite: {
    type: "registry-client-multipart",
    url: "http://localhost:3000",
    credentialSource: "runtime-env",
  },
  productionWrite: {
    type: "r2-sigv4",
    bucket: "factory-wager-registry",
    credentialSource: "proton-pass",
  },
}
