{
  "schemaVersion": 1,
  "kind": "weave-subdomain-probes",
  "note": "Probe matrix for `bun run verify:weave -- --subdomains`. Host inventory SSOT remains config/surfaces.toml (live only — no vanity/retired).",
  "subdomains": [
    {
      "name": "score",
      "domain": "score.factory-wager.com",
      "checks": ["/health", "/registry/portal-weave.json"]
    },
    {
      "name": "registry",
      "domain": "registry.factory-wager.com",
      "checks": ["/health", "/api/registry/health"]
    },
    {
      "name": "tennis",
      "domain": "tennis.factory-wager.com",
      "checks": [
        { "path": "/api/version", "expect": "json" },
        { "path": "/api/glossary", "expect": "json" },
        { "path": "/api/v1/marketdata/desk", "expect": "bearer-auth" },
        { "path": "/api/v1/research/status", "expect": "bearer-auth" },
        { "path": "/api/v1/trading/executions", "expect": "bearer-auth" },
        { "path": "/api/v1/partners/capacity", "expect": "bearer-auth" },
        { "path": "/api/v1/accounting/finance", "expect": "bearer-auth" }
      ]
    },
    {
      "name": "pages_dev",
      "domain": "project-r-score.pages.dev",
      "checks": ["/health", "/registry/portal-weave.json"]
    },
    {
      "name": "wiki",
      "domain": "wiki.factory-wager.com",
      "checks": [{ "path": "/", "expect": "ok" }]
    }
  ]
}
