{
  "name": "plannotator-extra-skills",
  "version": "0.1.0",
  "description": "Local mirror of optional Plannotator agent skills",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test ./.agents/skills/plannotator-compound/SKILL.test.ts ./.agents/skills/plannotator-setup-goal/SKILL.test.ts ./.agents/skills/plannotator-visual-explainer/SKILL.test.ts ./docs/references/references.test.ts ./lib/bun-native.test.ts ./lib/effect/boundary.test.ts ./lib/gate-report.test.ts",
    "typecheck": "tsc --noEmit",
    "ground-references": "bun run scripts/ground-references.ts",
    "ground-references:online": "bun run scripts/ground-references.ts --online",
    "ast-grep:test": "ast-grep test",
    "ast-grep:scan": "ast-grep scan",
    "gate-report": "bun run scripts/gate-report.ts",
    "gate-report:fail-demo": "bun run scripts/gate-report.ts -- --fixture fail --output reports/gate-report-fail-demo.html --no-history --open",
    "gate-report:annotate": "bun run scripts/annotate-gate-report.ts",
    "pre-commit": "./scripts/pre-commit.sh",
    "check": "bun run typecheck && bun run ast-grep:test && bun run ast-grep:scan && bun run test && ./scripts/verify-hashes.sh",
    "check:report": "bun run gate-report"
  },
  "dependencies": {
    "effect": "^3.21.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
