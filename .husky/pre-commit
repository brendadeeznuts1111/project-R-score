#!/usr/bin/env sh
set -e

DRY_RUN=0
if [ "$1" = "--dry-run" ]; then
  DRY_RUN=1
fi

# Hygiene ‖ harness in parallel; ast-grep after (may depend on clean tree).
# Kill background siblings on INT/TERM/EXIT so a cancelled hook does not leave orphans.
# Belt-and-suspenders with workspace [run] noOrphans = true (bunfig.toml).
echo "== pre-commit: hygiene ‖ harness =="
bun scripts/repo-hygiene.ts --staged &
HID=$!
bun scripts/pre-commit-harness.ts &
PID=$!

cleanup() {
  status=$?
  # Best-effort: stop still-running siblings (ignore failures).
  kill "$HID" 2>/dev/null || true
  kill "$PID" 2>/dev/null || true
  wait "$HID" 2>/dev/null || true
  wait "$PID" 2>/dev/null || true
  return "$status"
}
trap cleanup INT TERM EXIT

h_code=0
p_code=0
wait "$HID" || h_code=$?
wait "$PID" || p_code=$?

# Successful waits: clear trap so EXIT does not re-kill finished jobs.
trap - INT TERM EXIT

if [ "$h_code" -ne 0 ]; then
  echo "❌ repo hygiene failed"
  exit "$h_code"
fi
if [ "$p_code" -ne 0 ]; then
  echo "❌ harness pre-commit failed"
  exit "$p_code"
fi

echo ""
echo "== pre-commit: package.json scripts guard =="
# Hard fail on silent script removals (PR #149 deleted ~70 ops scripts in an
# unrelated diff). Escape: SKIP_SCRIPTS_GUARD=1 + reason in commit message.
if [ "$DRY_RUN" -eq 1 ]; then
  echo "  [dry-run] bun scripts/check-package-scripts.ts"
else
  bun scripts/check-package-scripts.ts || {
    echo "❌ package-scripts guard failed"
    exit 1
  }
fi

# Keep generated .vscode/mcp.json in lockstep when the MCP SSOT changes.
if git diff --cached --name-only | grep -q '^\.mcp\.json$'; then
  echo ""
  echo "== pre-commit: mcp sync (.mcp.json staged) =="
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "  [dry-run] bun scripts/mcp-sync.ts && git add .vscode/mcp.json"
  else
    bun scripts/mcp-sync.ts
    git add .vscode/mcp.json
  fi
fi

echo ""
echo "== pre-commit: ast-grep + semver =="
bun scripts/pre-commit-ast-grep.ts --staged

echo ""
echo "== pre-commit: gitleaks secret scan (staged) =="
# Staged-scoped: full-tree `detect --no-git` scans 2.6GB / ~4min and reports
# hundreds of pre-existing fixture findings, which would block every commit on
# foreign content (and is why the gate was silently skipped — nobody could
# install it). protect --staged gates NEW staged content only (~0.02s).
# Full-tree audit stays a manual command: bun run check:secrets
# Escape: SKIP_GITLEAKS=1 + reason in commit message.
if [ "${SKIP_GITLEAKS:-}" = "1" ]; then
  echo "  ⏭️  SKIP_GITLEAKS=1"
elif command -v gitleaks &>/dev/null; then
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "  [dry-run] gitleaks protect --staged --config .gitleaks.toml --verbose"
  else
    # Installed scanners are hard gates. Never turn a credential finding into
    # a successful commit through a trailing `|| true` or non-pipefail shell.
    gitleaks protect --staged --config .gitleaks.toml --verbose
  fi
else
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "  ⚠️  [dry-run] gitleaks not installed — would skip"
  else
    echo "  ⚠️  gitleaks not installed — skip (brew install gitleaks)"
  fi
fi

echo ""
echo "== pre-commit: test:changed (staged-scoped, bail) =="
# Staged-scoped: selection runs in a HEAD ∪ staged scratch repo so another
# lane's dirty-tree test failures cannot block this commit.
# Hard fail — catch broken tests before push. Opt out: SKIP_TEST_CHANGED=1
if [ "$DRY_RUN" -eq 1 ]; then
  if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|js|jsx|mts|cts)$'; then
    bun scripts/bun-test-changed-staged.ts --dry-run --bail=1
  else
    echo "  ⏭️  [dry-run] no staged TS/JS — test:changed would skip"
  fi
elif [ "${SKIP_TEST_CHANGED:-}" = "1" ]; then
  echo "  ⏭️  SKIP_TEST_CHANGED=1"
else
  # Staged TS/JS only — skip pure docs/registry bakes
  if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|js|jsx|mts|cts)$'; then
    bun scripts/bun-test-changed-staged.ts --bail=1 || {
      echo "❌ test:changed failed (bail=1). Fix or SKIP_TEST_CHANGED=1 with reason in commit message."
      exit 1
    }
  else
    echo "  ⏭️  no staged TS/JS — skip test:changed"
  fi
fi

echo ""
if [ "$DRY_RUN" -eq 1 ]; then
  echo "✅ Pre-commit dry-run complete (no changes made)"
else
  echo "✅ Pre-commit checks passed"
fi
