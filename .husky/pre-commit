#!/usr/bin/env sh
set -e

# Hygiene ‖ harness in parallel; ast-grep after (may depend on clean tree).
# Kill background siblings on INT/TERM/EXIT so a cancelled hook does not leave orphans.
# Belt-and-suspenders with workspace [run] noOrphans = true (bunfig.toml).
echo "== pre-commit: hygiene ‖ harness =="
bun scripts/repo-hygiene.ts --staged &
HID=$!
bun scripts/pre-commit-harness.ts &
PID=$!

cleanup() {
  status=$?
  # Best-effort: stop still-running siblings (ignore failures).
  kill "$HID" 2>/dev/null || true
  kill "$PID" 2>/dev/null || true
  wait "$HID" 2>/dev/null || true
  wait "$PID" 2>/dev/null || true
  return "$status"
}
trap cleanup INT TERM EXIT

h_code=0
p_code=0
wait "$HID" || h_code=$?
wait "$PID" || p_code=$?

# Successful waits: clear trap so EXIT does not re-kill finished jobs.
trap - INT TERM EXIT

if [ "$h_code" -ne 0 ]; then
  echo "❌ repo hygiene failed"
  exit "$h_code"
fi
if [ "$p_code" -ne 0 ]; then
  echo "❌ harness pre-commit failed"
  exit "$p_code"
fi

# Keep generated .vscode/mcp.json in lockstep when the MCP SSOT changes.
if git diff --cached --name-only | grep -q '^\.mcp\.json$'; then
  echo ""
  echo "== pre-commit: mcp sync (.mcp.json staged) =="
  bun scripts/mcp-sync.ts
  git add .vscode/mcp.json
fi

echo ""
echo "== pre-commit: ast-grep + semver =="
bun scripts/pre-commit-ast-grep.ts --staged

echo ""
echo "== pre-commit: gitleaks secret scan =="
if command -v gitleaks &>/dev/null; then
  if [ "$1" = "--dry-run" ]; then
    echo "  [dry-run] gitleaks detect --source . --no-git --config .gitleaks.toml -v"
  else
    gitleaks detect --source . --no-git --config .gitleaks.toml --verbose 2>&1 | tail -5 || true
  fi
else
  echo "  ⚠️  gitleaks not installed — skip (brew install gitleaks)"
fi

echo ""
echo "== pre-commit: type-check (tools) =="
# Only when tools/ is staged — full type-check:tools is ~400 errors on canary types (non-gate CI).
if [ "$1" = "--dry-run" ]; then
  echo "  [dry-run] type-check:tools if tools/ staged"
else
  if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^tools/'; then
    bun run type-check:tools 2>&1 | tail -5 || echo "  ⚠️  type-check:tools failed (non-blocking)"
  else
    echo "  ⏭️  no tools/ staged — skip type-check:tools"
  fi
fi

echo ""
echo "== pre-commit: env defaults check =="
# Staged-only + harness heuristics. Non-blocking until clean.
if [ "$1" = "--dry-run" ]; then
  echo "  [dry-run] bun scripts/check-env-defaults.ts --staged --dry-run"
else
  bun scripts/check-env-defaults.ts --staged || echo "  ⚠️  env-defaults: staged optional config without fallback (non-blocking)"
fi

echo ""
echo "== pre-commit: env vault-gap ratchet =="
if [ "$1" = "--dry-run" ]; then
  echo "  [dry-run] bun scripts/env-inventory.ts --ratchet"
else
  # Soft fail for now (baseline exists); promote to hard fail when team is ready
  bun scripts/env-inventory.ts --ratchet 2>&1 | tail -20 || echo "  ⚠️  vault-gap ratchet failed (non-blocking)"
fi

echo ""
echo "== pre-commit: test:changed (bail) =="
# Import-graph filter + parallel workers; short-circuits on docs-only diffs.
# Hard fail — catch broken tests before push. Opt out: SKIP_TEST_CHANGED=1
if [ "$1" = "--dry-run" ]; then
  echo "  [dry-run] bun run test:changed -- --bail=1"
elif [ "${SKIP_TEST_CHANGED:-}" = "1" ]; then
  echo "  ⏭️  SKIP_TEST_CHANGED=1"
else
  # Staged TS/JS only — skip pure docs/registry bakes
  if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(ts|tsx|js|jsx|mts|cts)$'; then
    bun run test:changed -- --bail=1 || {
      echo "❌ test:changed failed (bail=1). Fix or SKIP_TEST_CHANGED=1 for docs-only escape."
      exit 1
    }
  else
    echo "  ⏭️  no staged TS/JS — skip test:changed"
  fi
fi

echo ""
if [ "$1" = "--dry-run" ]; then
  echo "✅ Pre-commit dry-run complete (no changes made)"
else
  echo "✅ Pre-commit checks passed"
fi
