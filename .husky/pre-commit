#!/usr/bin/env sh
set -e

# Hygiene ‖ harness in parallel; ast-grep after (may depend on clean tree).
# Kill background siblings on INT/TERM/EXIT so a cancelled hook does not leave orphans.
# Belt-and-suspenders with workspace [run] noOrphans = true (bunfig.toml).
echo "== pre-commit: hygiene ‖ harness =="
bun scripts/repo-hygiene.ts --staged &
HID=$!
bun scripts/pre-commit-harness.ts &
PID=$!

cleanup() {
  status=$?
  # Best-effort: stop still-running siblings (ignore failures).
  kill "$HID" 2>/dev/null || true
  kill "$PID" 2>/dev/null || true
  wait "$HID" 2>/dev/null || true
  wait "$PID" 2>/dev/null || true
  return "$status"
}
trap cleanup INT TERM EXIT

h_code=0
p_code=0
wait "$HID" || h_code=$?
wait "$PID" || p_code=$?

# Successful waits: clear trap so EXIT does not re-kill finished jobs.
trap - INT TERM EXIT

if [ "$h_code" -ne 0 ]; then
  echo "❌ repo hygiene failed"
  exit "$h_code"
fi
if [ "$p_code" -ne 0 ]; then
  echo "❌ harness pre-commit failed"
  exit "$p_code"
fi

echo ""
echo "== pre-commit: ast-grep + semver =="
bun scripts/pre-commit-ast-grep.ts --staged

echo ""
echo "== pre-commit: gitleaks secret scan =="
if command -v gitleaks &>/dev/null; then
  if [ "$1" = "--dry-run" ]; then
    echo "  [dry-run] gitleaks detect --source . --no-git --config .gitleaks.toml -v"
  else
    gitleaks detect --source . --no-git --config .gitleaks.toml --verbose 2>&1 | tail -5 || true
  fi
else
  echo "  ⚠️  gitleaks not installed — skip (brew install gitleaks)"
fi

echo ""
echo "== pre-commit: type-check (tools) =="
if [ "$1" = "--dry-run" ]; then
  echo "  [dry-run] bun run type-check:tools"
else
  bun run type-check:tools 2>&1 | tail -3 || echo "  ⚠️  type-check failed (non-blocking in pre-commit)"
fi

echo ""
echo "== pre-commit: env defaults check =="
if [ "$1" = "--dry-run" ]; then
  echo "  [dry-run] bun scripts/check-env-defaults.ts --dry-run"
else
  bun scripts/check-env-defaults.ts || echo "  ⚠️  env-defaults check failed (non-blocking in pre-commit)"
fi

echo ""
if [ "$1" = "--dry-run" ]; then
  echo "✅ Pre-commit dry-run complete (no changes made)"
else
  echo "✅ Pre-commit checks passed"
fi
