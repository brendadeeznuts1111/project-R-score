{
  "version": 2,
  "description": "Executable per-skill loop capabilities",
  "defaultPhases": ["test", "bench", "rate"],
  "presets": {
    "quick": {
      "description": "ast-grep doctor and rating",
      "matrix": true,
      "phases": ["doctor", "rate"],
      "parallel": true
    },
    "standard": {
      "description": "ast-grep test, bench, and rating",
      "skill": "ast-grep",
      "phases": ["test", "bench", "rate"],
      "skipPreflight": true
    },
    "full": {
      "description": "ast-grep doctor, deep loop, and baseline capture",
      "matrix": true,
      "matrixPhases": ["doctor", "rate"],
      "skill": "ast-grep",
      "phases": ["doctor", "test", "bench", "snapshot", "rate"],
      "skipPreflight": true,
      "baselineWrite": true,
      "parallel": true
    },
    "ci": {
      "description": "ast-grep CI gate with snapshot preflight",
      "skill": "ast-grep",
      "phases": ["doctor", "test", "bench", "snapshot", "rate"],
      "failOnRating": 70,
      "skipPreflight": false
    },
    "precommit": {
      "description": "ast-grep doctor, precommit, and rating",
      "matrix": true,
      "matrixPhases": ["doctor", "precommit", "rate"],
      "parallel": true
    },
    "close-loop": {
      "description": "Ground truth to bench snapshot and baseline write",
      "skill": "ast-grep",
      "closeLoop": {
        "domain": "sports-terminal-os",
        "scanPath": "projects/active/sports-terminal-os/dist/frontend",
        "groundTruth": true,
        "iterations": 3,
        "targetMs": 1500,
        "baselineWrite": true,
        "ratingDriftTolerance": 15
      },
      "failOnRating": 70
    },
    "snapshot-bench": {
      "description": "Validate snapshot, live network, and ground truth three times",
      "skill": "ast-grep",
      "benchSnapshot": {
        "domain": "sports-terminal-os",
        "scanPath": "projects/active/sports-terminal-os/dist/frontend",
        "groundTruth": true,
        "iterations": 3,
        "targetMs": 1500
      },
      "failOnRating": 70
    }
  },
  "skills": {
    "ast-grep": {
      "path": ".agents/skills/ast-grep",
      "zone": "agents",
      "phases": {
        "test": { "enabled": true, "profile": "ci" },
        "bench": {
          "enabled": true,
          "profile": "unit",
          "iterations": 3,
          "targetMs": 8000
        },
        "network": {
          "enabled": true,
          "profile": "supply-chain-network-dist",
          "scanPath": "projects/active/sports-terminal-os/dist/frontend",
          "domain": "sports-terminal-os"
        },
        "snapshot": { "enabled": true, "domain": "sports-terminal-os" },
        "rate": { "enabled": true, "minRating": 70 },
        "doctor": { "enabled": true, "smoke": true },
        "precommit": { "enabled": true, "script": "precommit" }
      }
    }
  }
}
