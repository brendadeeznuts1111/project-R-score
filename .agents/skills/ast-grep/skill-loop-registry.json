{
  "version": 2,
  "description": "Per-skill loop capabilities \u2014 test, bench, network, snapshot, rate phases",
  "defaultPhases": [
    "test",
    "bench",
    "rate"
  ],
  "presets": {
    "quick": {
      "description": "Matrix doctor+rate across all registry skills",
      "matrix": true,
      "phases": [
        "doctor",
        "rate"
      ],
      "parallel": true
    },
    "standard": {
      "description": "ast-grep test+bench+rate (skip snapshot preflight)",
      "skill": "ast-grep",
      "phases": [
        "test",
        "bench",
        "rate"
      ],
      "skipPreflight": true
    },
    "full": {
      "description": "Matrix quick scan + ast-grep deep loop + baseline capture",
      "matrix": true,
      "matrixPhases": [
        "doctor",
        "rate"
      ],
      "skill": "ast-grep",
      "phases": [
        "doctor",
        "test",
        "bench",
        "snapshot",
        "rate"
      ],
      "skipPreflight": true,
      "baselineWrite": true,
      "parallel": true
    },
    "ci": {
      "description": "ast-grep CI gate with snapshot preflight",
      "skill": "ast-grep",
      "phases": [
        "doctor",
        "test",
        "bench",
        "snapshot",
        "rate"
      ],
      "failOnRating": 70,
      "skipPreflight": false
    },
    "precommit": {
      "description": "Husky-aligned gates: doctor + precommit + rate across registry",
      "matrix": true,
      "matrixPhases": [
        "doctor",
        "precommit",
        "rate"
      ],
      "parallel": true
    },
    "close-loop": {
      "description": "Closed loop: ground-truth \u2192 bench-snapshot \u00d73 \u2192 baseline diff/write",
      "skill": "ast-grep",
      "closeLoop": {
        "domain": "sports-terminal-os",
        "scanPath": "projects/active/sports-terminal-os/dist/frontend",
        "groundTruth": true,
        "iterations": 3,
        "targetMs": 1500,
        "baselineWrite": true,
        "ratingDriftTolerance": 15
      },
      "failOnRating": 70
    },
    "snapshot-bench": {
      "description": "bench-snapshot \u00d73: validateSnapshotFull + live network + ground-truth gate",
      "skill": "ast-grep",
      "benchSnapshot": {
        "domain": "sports-terminal-os",
        "scanPath": "projects/active/sports-terminal-os/dist/frontend",
        "groundTruth": true,
        "iterations": 3,
        "targetMs": 1500
      },
      "failOnRating": 70
    }
  },
  "skills": {
    "ast-grep": {
      "path": ".agents/skills/ast-grep",
      "zone": "agents",
      "phases": {
        "test": {
          "enabled": true,
          "profile": "ci"
        },
        "bench": {
          "enabled": true,
          "profile": "unit",
          "iterations": 3,
          "targetMs": 8000
        },
        "network": {
          "enabled": true,
          "profile": "supply-chain-network-dist",
          "scanPath": "projects/active/sports-terminal-os/dist/frontend",
          "domain": "sports-terminal-os"
        },
        "snapshot": {
          "enabled": true,
          "domain": "sports-terminal-os"
        },
        "rate": {
          "enabled": true,
          "minRating": 70
        },
        "doctor": {
          "enabled": true
        },
        "precommit": {
          "enabled": true,
          "script": "precommit"
        }
      }
    },
    "sports-terminal-os": {
      "path": ".agents/skills/sports-terminal-os",
      "zone": "agents",
      "workspace": "projects/active/sports-terminal-os",
      "phases": {
        "test": {
          "enabled": false
        },
        "network": {
          "enabled": true,
          "profile": "supply-chain-network-dist",
          "scanPath": "projects/active/sports-terminal-os/dist/frontend",
          "domain": "sports-terminal-os"
        },
        "snapshot": {
          "enabled": true,
          "domain": "sports-terminal-os"
        },
        "rate": {
          "enabled": true,
          "minRating": 60
        },
        "doctor": {
          "enabled": true
        },
        "precommit": {
          "enabled": false,
          "note": "delegates to ast-grep staged gate"
        }
      }
