{
  "version": 3,
  "zones": {
    "sports-terminal": "Sports Terminal OS — Bun.serve proxy terminal, partner zones, Telegram",
    "kimi": "Kimi plugin stack — odds scripts, MCP, shared",
    "packages": "Root workspace packages — guards, versioning, business libs",
    "agents": "Agent skills, orchestration, and ast-grep tooling"
  },
  "navigation": {
    "sports-terminal": [
      "sports-terminal-entry",
      "sports-terminal-router",
      "sports-terminal-api",
      "sports-terminal-services",
      "sports-terminal-partner",
      "sports-terminal-telegram"
    ],
    "kimi": [
      "kimi-shared",
      "kimi-f402-lib",
      "kimi-sports-plugin",
      "kimi-mcp-server"
    ],
    "packages": [
      "packages-guards",
      "packages-versioning",
      "packages-business"
    ],
    "agents": [
      "agents-ast-grep",
      "agents-sports-terminal-skill",
      "agents-partner-profile",
      "agents-domain-orchestrator",
      "agents-domain-diagnostic"
    ]
  },
  "targets": [
    {
      "id": "sports-terminal-entry",
      "zone": "sports-terminal",
      "name": "Sports Terminal boot (Bun.serve)",
      "path": "projects/active/sports-terminal-os/src/index.ts",
      "view": "digest",
      "bun_rules": true,
      "tags": ["entry", "http", "bun"],
      "anchors": ["Bun.serve", "Bun.file", "createLogger"],
      "description": "Main Bun.serve wiring and server boot"
    },
    {
      "id": "sports-terminal-api",
      "zone": "sports-terminal",
      "name": "Sports Terminal API routes",
      "path": "projects/active/sports-terminal-os/src/api",
      "view": "names",
      "items": "exports",
      "globs": ["!**/*.test.ts"],
      "bun_rules": true,
      "tags": ["api", "routes", "bun"],
      "depends_on": ["sports-terminal-router"],
      "anchors": ["handleRequest", "router", "proxy"],
      "description": "Route handlers and proxy endpoints"
    },
    {
      "id": "sports-terminal-services",
      "zone": "sports-terminal",
      "name": "Sports Terminal services",
      "path": "projects/active/sports-terminal-os/src/services",
      "view": "names",
      "items": "structure",
      "globs": ["!**/*.test.ts"],
      "tags": ["services", "domain", "bun"],
      "depends_on": ["sports-terminal-api"],
      "anchors": ["WebSocket", "createLogger", "subscribe"],
      "description": "Domain logic, WS handlers, AI risk"
    },
    {
      "id": "sports-terminal-router",
      "zone": "sports-terminal",
      "name": "Sports Terminal router (digest)",
      "path": "projects/active/sports-terminal-os/src/api/router.ts",
      "view": "digest",
      "bun_rules": true,
      "tags": ["router", "bun"],
      "anchors": ["routes", "Route", "handler"],
      "description": "Central route table — start here for API shape"
    },
    {
      "id": "sports-terminal-partner",
      "zone": "sports-terminal",
      "name": "Partner Profile OS kernel",
      "path": "projects/active/sports-terminal-os/src/zones/partner-profile",
      "view": "names",
      "items": "exports",
      "globs": ["!**/*.test.ts"],
      "bun_rules": true,
      "tags": ["partner", "gateway", "bun"],
      "depends_on": ["sports-terminal-services"],
      "anchors": ["PartnerGateway", "evaluate", "GateResult"],
      "description": "PartnerGateway.evaluate — lifecycle gates and SOR routing"
    },
    {
      "id": "sports-terminal-telegram",
      "zone": "sports-terminal",
      "name": "Telegram bot hub",
      "path": "projects/active/sports-terminal-os/src/telegram",
      "view": "names",
      "globs": ["!**/*.test.ts"],
      "tags": ["telegram", "redis", "bun"],
      "depends_on": ["sports-terminal-services"],
      "anchors": ["run-bots", "Redis", "XREADGROUP"],
      "description": "Multi-bot launcher and Redis Streams workers"
    },
    {
      "id": "kimi-sports-plugin",
      "zone": "kimi",
      "name": "Kimi sports-odds plugin scripts",
      "path": "kimi-plugin/sports-odds-plugin/scripts",
      "view": "names",
      "tags": ["cli", "odds"],
      "depends_on": ["kimi-f402-lib", "kimi-shared"],
      "anchors": ["main", "f402Fetch", "loadConfig", "makeTable"],
      "description": "get_odds, get_scores, get_handle CLI scripts"
    },
    {
      "id": "kimi-f402-lib",
      "zone": "kimi",
      "name": "Kimi f402 client lib",
      "path": "kimi-plugin/sports-odds-plugin/scripts/lib/f402.ts",
      "view": "digest",
      "tags": ["lib", "fetch"],
      "depends_on": ["kimi-shared"],
      "anchors": ["f402Fetch", "fetch", "makeTable"],
      "description": "Shared f402 fetch + table helpers"
    },
    {
      "id": "kimi-shared",
      "zone": "kimi",
      "name": "Kimi shared constants",
      "path": "kimi-plugin/shared",
      "view": "names",
      "items": "exports",
      "tags": ["shared"],
      "anchors": ["SPORT_POSSESSION_EMOJI", "riskEmoji", "riskColor"],
      "description": "Cross-plugin constants and risk helpers"
    },
    {
      "id": "kimi-mcp-server",
      "zone": "kimi",
      "name": "Kimi sports MCP server",
      "path": "kimi-plugin/sports-mcp-server",
      "view": "names",
      "globs": ["!**/*.test.ts"],
      "tags": ["mcp", "websocket"],
      "depends_on": ["kimi-shared"],
      "anchors": ["tools", "WebSocket", "subscribe", "readToolArgs"],
      "description": "MCP tools + WS subscription handlers"
    },
    {
      "id": "packages-guards",
      "zone": "packages",
      "name": "@factorywager/guards",
      "path": "packages/guards",
      "view": "names",
      "items": "exports",
      "tags": ["package", "guards"],
      "anchors": ["exports"],
      "description": "Shared guard utilities"
    },
    {
      "id": "packages-versioning",
      "zone": "packages",
      "name": "@factorywager/versioning",
      "path": "packages/versioning",
      "view": "names",
      "items": "exports",
      "tags": ["package", "semver"],
      "description": "Versioning helpers"
    },
    {
      "id": "packages-business",
      "zone": "packages",
      "name": "@factorywager/business",
      "path": "packages/business",
      "view": "names",
      "items": "exports",
      "tags": ["package", "domain"],
      "description": "Business domain types and helpers"
    },
    {
      "id": "agents-ast-grep",
      "zone": "agents",
      "name": "ast-grep skill bundle",
      "path": ".agents/skills/ast-grep",
      "view": "names",
      "items": "structure",
      "globs": ["!**/node_modules/**", "!**/__snapshots__/**"],
      "tags": ["skill", "ast-grep"],
      "anchors": ["cmd_outline", "cmd_map", "cmd_index", "ast_grep_helper"],
      "description": "This skill — helper, rules, MCP, repo-map"
    },
    {
      "id": "agents-sports-terminal-skill",
      "zone": "agents",
      "name": "sports-terminal-os skill",
      "path": ".agents/skills/sports-terminal-os",
      "view": "digest",
      "tags": ["skill", "sports-terminal"],
      "anchors": ["Bun.serve", "PartnerGateway", "router"],
      "description": "SKILL.md runbook for Sports Terminal OS workspace"
    },
    {
      "id": "agents-partner-profile",
      "zone": "agents",
      "name": "partner-profile-os skill",
      "path": ".agents/skills/partner-profile-os",
      "view": "digest",
      "tags": ["skill", "partner"],
      "anchors": ["PartnerGateway", "evaluate", "TOML"],
      "description": "Partner Profile OS skill — gateway, lifecycle, SOR"
    },
    {
      "id": "agents-domain-orchestrator",
      "zone": "agents",
      "name": "domain-orchestrator skill",
      "path": ".agents/skills/domain-orchestrator",
      "view": "digest",
      "tags": ["skill", "orchestrator", "flow"],
      "anchors": ["SkillOrchestrator", "executeFlowSkill"],
      "description": "Flow skill orchestration and domain API mapping"
    },
    {
      "id": "agents-domain-diagnostic",
      "zone": "agents",
      "name": "domain-diagnostic-flow skill",
      "path": ".agents/skills/domain-diagnostic-flow",
      "view": "digest",
      "tags": ["skill", "diagnostic", "healing"],
      "description": "Domain health check and remediation flows"
    }
  ]
}