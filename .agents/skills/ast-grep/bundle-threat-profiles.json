{
  "version": 1,
  "description": "Bun.Transpiler bundle-threat scan profiles",
  "profiles": {
    "default": {
      "description": "Full scan — imports, source patterns, transpiled output",
      "min_severity": "info",
      "transform_output": true,
      "use_scan_imports": false,
      "max_file_kb": 512
    },
    "ci": {
      "description": "CI gate — error-level threats only",
      "min_severity": "error",
      "transform_output": true,
      "use_scan_imports": false,
      "max_file_kb": 512
    },
    "imports-only": {
      "description": "Fast path — scanImports only, no transformSync",
      "min_severity": "warn",
      "transform_output": false,
      "use_scan_imports": true,
      "max_file_kb": 1024
    },
    "bundle-dist": {
      "description": "Scan build output — includes dist/, skips minified",
      "min_severity": "warn",
      "transform_output": true,
      "use_scan_imports": false,
      "max_file_kb": 2048,
      "include_node_modules": false
    },
    "supply-chain-ci": {
      "description": "Layer 4.5 CI — critical/high rules, integrity-ready",
      "min_severity": "error",
      "transform_output": true,
      "use_scan_imports": false,
      "max_file_kb": 512
    }
  }
}