      "name": "Bun.secrets",
      "pattern": "Bun.secrets",
      "lang": "ts",
      "group": "secrets",
      "outline": true,
      "tier": "extended",
      "description": "OS keychain / credential store"
    },
    {
      "id": "bun-shell",
      "name": "Bun.$",
      "pattern": "await Bun.$`$$$`",
      "lang": "ts",
      "group": "shell",
      "outline": false,
      "tier": "extended",
      "description": "Shell template execution"
    },
    {
      "id": "bun-sqlite",
      "name": "bun:sqlite",
      "pattern": "import { $$$ } from \"bun:sqlite\"",
      "lang": "ts",
      "group": "db",
      "outline": true,
      "tier": "core",
      "description": "SQLite built-in driver"
    },
    {
      "id": "bun-test",
      "name": "bun:test",
      "pattern": "import { $$$ } from \"bun:test\"",
      "lang": "ts",
      "group": "test",
      "outline": false,
      "tier": "core",
      "description": "Bun test runner"
    },
    {
      "id": "bun-test-describe",
      "name": "describe()",
      "pattern": "describe($$$)",
      "lang": "ts",
      "group": "test",
      "outline": false,
      "tier": "extended",
      "description": "Test suite block (usually with bun:test)"
    },
    {
      "id": "bun-ffi",
      "name": "bun:ffi",
      "pattern": "import { $$$ } from \"bun:ffi\"",
      "lang": "ts",
      "group": "modules",
      "outline": false,
      "tier": "extended",
      "description": "Foreign function interface"
    },
    {
      "id": "bun-jsc",
      "name": "bun:jsc",
      "pattern": "import { $$$ } from \"bun:jsc\"",
      "lang": "ts",
      "group": "modules",
      "outline": false,
      "tier": "extended",
      "description": "JavaScriptCore introspection"
    },
    {
      "id": "node-fs",
      "name": "node:fs import",
      "pattern": "import $X from \"fs\"",
      "lang": "ts",
      "group": "anti-pattern",
      "outline": false,
      "tier": "migrate",
      "description": "Node fs — prefer Bun.file"
    },
    {
      "id": "node-fs-explicit",
      "name": "node:fs explicit",
      "pattern": "import $X from \"node:fs\"",
      "lang": "ts",
      "group": "anti-pattern",
      "outline": false,
      "tier": "migrate",
      "description": "Explicit node:fs — prefer Bun.file"
    },
    {
      "id": "node-child-process",
      "name": "child_process",
      "pattern": "import { $$$ } from \"child_process\"",
      "lang": "ts",
      "group": "anti-pattern",
      "outline": false,
      "tier": "migrate",
      "description": "Node child_process — prefer Bun.spawn"
    },
    {
      "id": "node-http",
      "name": "node:http",
      "pattern": "import $X from \"http\"",
      "lang": "ts",
      "group": "anti-pattern",
      "outline": false,
      "tier": "migrate",
      "description": "Node http — prefer Bun.serve"
    }
  ]
