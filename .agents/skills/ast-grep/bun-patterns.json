{
  "version": 2,
  "description": "Bun native API structural patterns — inventory, matrix, and search",
  "groups": {
    "http": "Servers, fetch, WebSocket",
    "io": "Bun.file, Bun.write, Bun.Glob, streams",
    "process": "Bun.spawn, Bun.which, Bun.argv, Bun.main",
    "db": "bun:sqlite and database usage",
    "test": "bun:test runner",
    "crypto": "Bun.hash, Bun.password, CryptoHasher",
    "runtime": "Bun.env, Bun.version, Bun.nanoseconds",
    "display": "Bun.inspect, Bun.color, Bun.markdown",
    "secrets": "Bun.secrets keychain",
    "shell": "Bun.$ shell templates",
    "modules": "bun:* built-in module imports",
    "anti-pattern": "Node APIs to migrate away from"
  },
  "patterns": [
    {
      "id": "bun-serve",
      "name": "Bun.serve",
      "pattern": "Bun.serve($$$)",
      "lang": "ts",
      "group": "http",
      "outline": true,
      "tier": "core",
      "description": "HTTP/WebSocket server boot"
    },
    {
      "id": "fetch-native",
      "name": "fetch",
      "pattern": "fetch($$$)",
      "lang": "ts",
      "group": "http",
      "outline": true,
      "tier": "core",
      "description": "Bun-native fetch"
    },
    {
      "id": "websocket",
      "name": "WebSocket",
      "pattern": "new WebSocket($$$)",
      "lang": "ts",
      "group": "http",
      "outline": true,
      "tier": "core",
      "description": "WebSocket client"
    },
    {
      "id": "bun-file",
      "name": "Bun.file",
      "pattern": "Bun.file($$$)",
      "lang": "ts",
      "group": "io",
      "outline": true,
      "tier": "core",
      "description": "Native file reads — prefer over node:fs"
    },
    {
      "id": "bun-write",
      "name": "Bun.write",
      "pattern": "Bun.write($$$)",
      "lang": "ts",
      "group": "io",
      "outline": true,
      "tier": "core",
      "description": "Native file writes"
    },
    {
      "id": "bun-remove",
      "name": "Bun.remove",
      "pattern": "Bun.remove($$$)",
      "lang": "ts",
      "group": "io",
      "outline": true,
      "tier": "extended",
      "description": "Delete files/directories"
    },
    {
      "id": "bun-glob",
      "name": "Bun.Glob",
      "pattern": "new Bun.Glob($$$)",
      "lang": "ts",
      "group": "io",
      "outline": true,
      "tier": "extended",
      "description": "Glob file traversal"
    },
    {
      "id": "bun-stdin",
      "name": "Bun.stdin",
      "pattern": "Bun.stdin",
      "lang": "ts",
      "group": "io",
      "outline": true,
      "tier": "extended",
      "description": "Stdin stream"
    },
    {
      "id": "bun-spawn",
      "name": "Bun.spawn",
      "pattern": "Bun.spawn($$$)",
      "lang": "ts",
      "group": "process",
      "outline": true,
      "tier": "core",
      "description": "Child process spawn"
    },
    {
      "id": "bun-which",
      "name": "Bun.which",
      "pattern": "Bun.which($$$)",
      "lang": "ts",
      "group": "process",
      "outline": true,
      "tier": "extended",
      "description": "Resolve executable on PATH"
    },
    {
      "id": "bun-argv",
      "name": "Bun.argv",
      "pattern": "Bun.argv",
      "lang": "ts",
      "group": "process",
      "outline": true,
      "tier": "core",
      "description": "CLI argument vector"
    },
    {
      "id": "bun-main",
      "name": "Bun.main",
      "pattern": "Bun.main",
      "lang": "ts",
      "group": "process",
      "outline": true,
      "tier": "extended",
      "description": "Entry module check"
    },
    {
      "id": "bun-sleep",
      "name": "Bun.sleep",
      "pattern": "Bun.sleep($$$)",
      "lang": "ts",
      "group": "runtime",
      "outline": true,
      "tier": "core",
      "description": "Native async sleep"
    },
    {
      "id": "bun-env",
      "name": "Bun.env",
      "pattern": "Bun.env",
      "lang": "ts",
      "group": "runtime",
      "outline": true,
      "tier": "core",
      "description": "Environment variables"
    },
    {
      "id": "bun-version",
      "name": "Bun.version",
      "pattern": "Bun.version",
      "lang": "ts",
      "group": "runtime",
      "outline": true,
      "tier": "extended",
      "description": "Runtime version string"
    },
    {
      "id": "bun-nanoseconds",
      "name": "Bun.nanoseconds",
      "pattern": "Bun.nanoseconds($$$)",
      "lang": "ts",
      "group": "runtime",
      "outline": true,
      "tier": "extended",
      "description": "High-resolution timer"
    },
    {
