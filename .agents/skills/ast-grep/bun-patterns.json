    {
      "id": "bun-password",
      "name": "Bun.password",
      "pattern": "Bun.password.$METHOD($$$)",
      "lang": "ts",
      "group": "crypto",
      "outline": true,
      "tier": "extended",
      "description": "bcrypt/argon password hashing"
    },
    {
      "id": "bun-crypto-hasher",
      "name": "Bun.CryptoHasher",
      "pattern": "new Bun.CryptoHasher($$$)",
      "lang": "ts",
      "group": "crypto",
      "outline": true,
      "tier": "extended",
      "description": "Streaming crypto hash"
    },
    {
      "id": "bun-inspect",
      "name": "Bun.inspect",
      "pattern": "Bun.inspect($$$)",
      "lang": "ts",
      "group": "display",
      "outline": true,
      "tier": "extended",
      "description": "Debug formatting"
    },
    {
      "id": "bun-inspect-table",
      "name": "Bun.inspect.table",
      "pattern": "Bun.inspect.table($$$)",
      "lang": "ts",
      "group": "display",
      "outline": true,
      "tier": "extended",
      "description": "ANSI table output"
    },
    {
      "id": "bun-color",
      "name": "Bun.color",
      "pattern": "Bun.color($$$)",
      "lang": "ts",
      "group": "display",
      "outline": true,
      "tier": "extended",
      "description": "Color conversion (hex, ansi, css)"
