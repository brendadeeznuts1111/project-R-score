    {
      "id": "bun-markdown-html",
      "name": "Bun.markdown.html",
      "pattern": "Bun.markdown.html($$$)",
      "lang": "ts",
      "group": "display",
      "outline": true,
      "tier": "extended",
      "description": "Markdown to HTML"
    },
    {
      "id": "bun-markdown-ansi",
      "name": "Bun.markdown.ansi",
      "pattern": "Bun.markdown.ansi($$$)",
      "lang": "ts",
      "group": "display",
      "outline": true,
      "tier": "extended",
      "description": "Markdown to ANSI terminal"
