{
  "version": 2,
  "description": "bun install CI recipes — linker, platform, lockfile, supply-chain",
  "env": {
    "cpu": "BUN_INSTALL_CPU",
    "os": "BUN_INSTALL_OS"
  },
  "profiles": {
    "default": {
      "description": "Standard install",
      "args": []
    },
    "hoisted": {
      "description": "Traditional flattened node_modules",
      "args": ["--linker", "hoisted"]
    },
    "isolated": {
      "description": "Strict dependency isolation (monorepo default)",
      "args": ["--linker", "isolated"]
    },
    "ci": {
      "description": "CI — frozen lockfile, no drift",
      "args": ["--frozen-lockfile"]
    },
    "ci-isolated": {
      "description": "CI monorepo — isolated linker + frozen lockfile",
      "args": ["--linker", "isolated", "--frozen-lockfile"]
    },
    "production": {
      "description": "Production deps only",
      "args": ["--production"]
    },
    "secure": {
      "description": "Minimum release age 3 days (259200s)",
      "args": ["--minimum-release-age", "259200"]
    },
    "secure-isolated": {
      "description": "Isolated linker + 3-day release age gate",
      "args": ["--linker", "isolated", "--minimum-release-age", "259200"]
    },
    "dry-run": {
      "description": "Resolve without writing node_modules",
      "args": ["--dry-run"]
    },
    "cross-linux-x64": {
      "description": "Install optional deps for linux x64 (cross-compile/deploy prep)",
      "args": ["--cpu=x64", "--os=linux"]
    },
    "cross-linux-arm64": {
      "description": "Install optional deps for linux arm64",
      "args": ["--cpu=arm64", "--os=linux"]
    },
    "cross-darwin-arm64": {
      "description": "Install optional deps for darwin arm64",
      "args": ["--cpu=arm64", "--os=darwin"]
    },
    "lockfile-only": {
      "description": "Generate bun.lock without installing node_modules",
      "args": ["--lockfile-only"]
    },
    "lockfile-migrate": {
      "description": "Upgrade bun.lockb → text bun.lock (then delete bun.lockb)",
      "args": ["--save-text-lockfile", "--frozen-lockfile", "--lockfile-only"]
    },
    "ignore-scripts": {
      "description": "Skip root package.json lifecycle scripts",
      "args": ["--ignore-scripts", "--frozen-lockfile"]
    }
  }
}