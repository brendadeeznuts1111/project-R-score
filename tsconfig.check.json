{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "types": [
      "bun-types"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "tsBuildInfoFile": ".cache/tsbuildinfo/check.tsbuildinfo"
  },
  "include": [
    "lib/types/**/*",
    "lib/path-bun.ts",
    "lib/harness/**/*",
    "lib/docs/**/*",
    "lib/utils/**/*",
    "lib/core/**/*",
    "spine/**/*",
    "lib/console-depth.ts",
    "lib/projects-scan.ts",
    "scripts/lib/cli-args.ts",
    "scripts/lib/cli-categories.ts",
    "scripts/lib/fs-bun.ts",
    "scripts/lib/dashboard-env.ts",
    "scripts/lib/graceful-shutdown.ts",
    "scripts/affected-workspaces.ts",
    "scripts/help.ts",
    "scripts/pre-commit-harness.ts",
    "scripts/check-path-bun.ts",
    "scripts/check-bun-env.ts",
    "scripts/harness-lesson.ts",
    "scripts/harness-status.ts",
    "scripts/ci-harness.ts",
    "scripts/ci-core.ts",
    "scripts/lint-bun-native-changed.ts",
    "scripts/lib/git-changed.ts",
    "scripts/check-pr-claim.ts",
    "scripts/bun-test-changed.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "env.d.ts",
    "**/*.test.ts",
    "**/*.bench.ts"
  ]
}
