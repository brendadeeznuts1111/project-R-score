{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "types": ["bun-types"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "tsBuildInfoFile": ".cache/tsbuildinfo/check.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "lib/udp/**/*",
    "lib/env/**/*",
    "lib/types/**/*",
    "lib/path-bun.ts",
    "lib/harness/**/*",
    "lib/console-depth.ts",
    "lib/projects-scan.ts",
    "lib/docs/repo-docs.ts",
    "lib/docs/token-ref.ts",
    "lib/docs/bun-token.ts",
    "lib/docs/token-ref-adapter.ts",
    "lib/docs/canonical-family.ts",
    "lib/docs/urls.ts",
    "lib/docs/smart-symbol-index.ts",
    "lib/docs/ripgrep-spawn.ts",
    "lib/utils/safe-file-operations.ts",
    "workers/protocol-bridge-worker.ts",
    "workers/ultra-pool.ts",
    "scripts/lib/cli-args.ts",
    "scripts/lib/cli-categories.ts",
    "scripts/lib/fs-bun.ts",
    "scripts/lib/dashboard-env.ts",
    "scripts/lib/graceful-shutdown.ts",
    "scripts/affected-workspaces.ts",
    "scripts/help.ts",
    "scripts/pre-commit-harness.ts",
    "scripts/check-path-bun.ts",
    "scripts/check-bun-env.ts",
    "scripts/harness-lesson.ts",
    "scripts/harness-status.ts",
    "types/**/*",
    "index.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "env.d.ts", "**/*.test.ts", "**/*.bench.ts"]
}
