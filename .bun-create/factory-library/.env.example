# Development checks and the release-readiness dry run require no environment variables.

# Required only by the non-interactive `bun run publish:ci` route.
NPM_CONFIG_TOKEN=

# Optional UTC-only cron preview inputs for the Bun 1.3.14 runtime floor.
TZ=UTC
CRON_TZ=UTC
CRON_SCHEDULE=@hourly

# Optional reporting and benchmark inputs.
PROJECT_NAME=
BENCH_ITERATIONS=50000
