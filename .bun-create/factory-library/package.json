{
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "A Bun-native library.",
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun build ./src/index.ts --outdir ./dist",
    "bench": "bun scripts/bench.ts",
    "profile:cpu": "bun --cpu-prof --cpu-prof-dir=./profiles scripts/bench.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "bun-create": {
    "preinstall": "echo '📦 Installing dependencies for {{name}}...'",
    "postinstall": [
      "echo '✓ {{name}} scaffolded successfully!'",
      "bun test",
      "echo 'Next: edit package.json (description) and src/index.ts, then run bun run build.'"
    ]
  }
}
