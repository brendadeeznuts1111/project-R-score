# FactoryWager Enterprise Platform - .gitignore

# Dependencies
node_modules/
bun.lockb
.bun-cache/
.bun/install/cache/
.pnpm-store/
.yarn/
.yarn/cache/

# Absolute path caches (from embedded projects)
**/$HOME/
*/.bun/install/cache/
**/bun/install/cache/

# Build outputs
dist/
.artifacts/
build/
!src/build/
out/
.next/
.nuxt/
.vite/
.cache/
*.js
!scratch/bun-v1.3.9-examples/playground-web/app.js
!scratch/bun-v1.3.9-examples/playground-web/url-sharing.js
*.js.map
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# IDE-specific configs
.claude/*
!.claude/agents/
!.claude/commands/
.cursor/
.windsurf/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bun config (contains secrets)
.bunfig.toml

# Environment variables
.env
.env.local
.env.secret.local
.env.*.local
.env.*
.env.production
.env.secret
.env.enc

# Test coverage
coverage/

# Temporary files
tmp/
temp/
.tmp/

# Project-specific
profiles/
*.profile.json
*-profile-*.json
*.cpuprofile
CPU.*.md
Heap.*.md

# Large data and cache directories
cache/
logs/
performance-results/
reports/
.archive/
*.archive/

# Working directories
temp/
tmp/
data/
output/
download/
archive/

# Generated and temporary content
*.scratch.*
*.temp.*
*.cache.*
*.output.*
*.download.*

# Test outputs
test-results/
coverage/
.nyc_output/

# Temporary and example files
example*-*
test*-*
!scripts/test-*.ts
*.tmp
*.temp

# Generated files
*.generated.*
*.auto.*
*.build.*
*.dist.*

# Build artifacts and large binaries
*.rdb
*.bun-build
*.tar.gz
*.tgz

# Development artifacts
*.local.*
*.dev.*
*.debug.*

# Native addons
*.node
*.so
*.dylib

# Cache
.cache/
.nyc_output/

# Session data
sessions/
cookies/

# Deployment artifacts
deploy/
.deploy/

# Uploads
uploads/
public/uploads/

# Misc
bun.lockb

# Projects without tokens or sensitive configurations
*config/
*secrets/
*.token
*.key
*.pem
*.p12
*.pfx
auth/
credentials/
.tokens/
.secrets/
.sensitive/

# Project directories that might contain sensitive data
**/config/
**/secrets/
**/auth/
**/credentials/.env.production
.env.secret
!config/
config/*
!config/domain-branding.json

# Runtime artifacts
profiles.db
deployment.log
dump.rdb
metrics/
plugins/
wrangler.toml
lib/ab-testing/bench-results.json

# Clawdbot - temporarily ignored
clawdbot/

# NPM Cache (should not be committed)
.npm-cache/

# Separate projects with their own git history
kimiremote/

# Secrets and credentials (should never be committed)
bun.secrets
.fw-config.json

# .env files (may contain secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
*.local.json

# SQLite artifacts (development databases)
*.db-shm
*.db-wal

# Runtime databases (should never be committed)
*.db
*.sqlite
*.sqlite3
profiles.db

# Heap snapshots and memory dumps
*.heapsnapshot
Heap-*

# Compiled binaries and object files
*.bin
*.o
*.obj
*.exe

# ML models (large binary files)
**/train-anomaly*
**/models/*.pkl
**/models/*.h5

# Tarball archives
*.tar
*.tar.gz
*.tgz
*.zip

# .icns and other binary assets
*.icns

# Smart environment cache (generated AI artifacts)
.smart-env/

# Bun native compiled output
*.bun-build
