# FactoryWager Enterprise Platform - .gitignore

# Dependencies
node_modules/
bun.lockb
bun.lock
package-lock.json
pnpm-lock.yaml
yarn.lock
.bun-cache/
.bun/install/cache/
.pnpm-store/
.yarn/
.yarn/cache/

# Absolute path caches (from embedded projects)
**/$HOME/
*/.bun/install/cache/
**/bun/install/cache/

# Build outputs
dist/
.artifacts/
build/
!src/build/
out/
.next/
.nuxt/
.vite/
.output/
.turbo/
.cache/
*.js
!scratch/bun-v1.3.9-examples/playground-web/app.js
!scratch/bun-v1.3.9-examples/playground-web/url-sharing.js
*.js.map
*.tsbuildinfo

# IDE — ignore local noise; track shared workspace configs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/mcp.json
!.vscode/bun-rscore.code-snippets
.idea/
*.swp
*.swo

# Cursor — track canonical MCP config; ignore local agent state
.cursor/*
!.cursor/mcp.json

# Other IDE / agent tooling
.claude/*
!.claude/agents/
!.claude/commands/
.windsurf/
.codex/
.agents/
.reasonix/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.jsonl
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bun reference profile (may contain enterprise secrets — not auto-loaded)
.bunfig.toml

# Environment variables
.env
.env.local
.env.secret.local
.env.*.local
.env.*
.env.development
.env.production
.env.staging
.env.test
.env.secret
.env.enc

# Test coverage
coverage/
.nyc_output/
test-results/

# Temporary files
tmp/
temp/
.tmp/

# Project-specific
profiles/
*.profile.json
*-profile-*.json
*.cpuprofile
CPU.*.md
Heap.*.md

# Large data and cache directories
cache/
logs/
performance-results/
reports/
.archive/
*.archive/

# Working directories
data/
output/
download/
archive/

# Generated and temporary content
*.scratch.*
*.temp.*
*.cache.*
*.output.*
*.download.*

# Temporary and example files
example*-*
test*-*
!scripts/test-*.ts
*.tmp

# Generated files
*.generated.*
*.auto.*
*.build.*
*.dist.*

# Build artifacts and large binaries
*.rdb
*.bun-build
*.tar.gz
*.tgz
*.tar
*.zip

# Development artifacts
*.local.*
*.dev.*
*.debug.*

# Native addons
*.node
*.so
*.dylib

# Session data
sessions/
cookies/

# Deployment artifacts
deploy/
.deploy/

# Uploads
uploads/
public/uploads/

# Projects without tokens or sensitive configurations
*config/
*secrets/
*.token
*.key
*.pem
*.p12
*.pfx
auth/
credentials/
.tokens/
.secrets/
.sensitive/

# Project directories that might contain sensitive data
**/config/
**/secrets/
**/auth/
**/credentials/
!config/
config/*
!config/domain-branding.json

# Runtime artifacts
profiles.db
deployment.log
dump.rdb
metrics/
plugins/
wrangler.toml
lib/ab-testing/bench-results.json

# Clawdbot - temporarily ignored
clawdbot/

# NPM Cache (should not be committed)
.npm-cache/

# Separate projects with their own git history
projects/active/kimiremote/

# Secrets and credentials (should never be committed)
bun.secrets
.fw-config.json
*.local.json

# SQLite artifacts (development databases)
*.db-shm
*.db-wal

# Runtime databases (should never be committed)
*.db
*.sqlite
*.sqlite3

# Heap snapshots and memory dumps
*.heapsnapshot
Heap-*
*.heapsnapshot

# Compiled binaries and object files
*.bin
*.o
*.obj
*.exe

# ML models (large binary files)
**/train-anomaly*
**/models/*.pkl
**/models/*.h5

# Binary assets
*.icns

# Smart environment cache (generated AI artifacts)
.smart-env/

# Docs archives (large snapshots)
docs/archives/

# Minified assets
*.min.js
*.min.css
*.bundle.js

# Vendored / third-party
vendor/
.third_party/
