          "CI_COMMIT_SHA",
          "GIT_SHA",
          "git HEAD",
        ],
        "name": "commit_source",
      },
      {
        "absence": "omitted; branch_source records state",
        "inputs": [
          "GITHUB_REF_NAME",
          "git branch",
