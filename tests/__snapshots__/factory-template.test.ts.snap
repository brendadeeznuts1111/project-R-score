        "name": "branch",
      },
      {
        "absence": "environment, git, detached, or unavailable",
        "inputs": [
          "GITHUB_REF_NAME",
          "git branch",
        ],
        "name": "branch_source",
      },
      {
        "absence": "omitted; repository_source records state",
        "inputs": [
