# .env.example

# Bun install — machine SSOT: ~/.bunfig.toml [install.cache].dir
# Do not set BUN_INSTALL_CACHE_DIR or BUN_INSTALL_GLOBAL_STORE in .env

# ============================================================================
# Cloudflare / R2 / Pages — SSOT: config/r2-env.ts (CLOUDFLARE_DEFAULTS)
# Status: bun run cloudflare:env · Tenant: docs/harness/tenants/cloudflare-pages.md
# ============================================================================

# Account + zone (non-secret). R2_* and CLOUDFLARE_* both kept — callers differ.
CLOUDFLARE_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
R2_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
CLOUDFLARE_ZONE_ID=a3b7ba4bb62cb1b177b04b8675250674
CLOUDFLARE_ZONE_NAME=factory-wager.com

# Secrets (never commit real values). Local: wrangler login. CI: API token.
# Required permissions (Layer 2): config/r2-env.ts CLOUDFLARE_TOKEN_PERMISSIONS
# Mint guide: docs/harness/tenants/cloudflare-pages.md#token-permissions-layer-2
# Scope probe: bun run cloudflare:env:validate
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Dedicated Zero Trust token; never reuse the Pages/DNS token for Access policy writes.
# Required: Access: Apps and Policies Read+Edit, Access: Service Tokens Read (account-scoped).
CLOUDFLARE_ACCESS_API_TOKEN=your_cloudflare_access_api_token
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# GitHub API auth (optional) — Bun channel resolve / bun upgrade rate limits
# Precedence: GITHUB_TOKEN → GITHUB_ACCESS_TOKEN → GH_TOKEN → `gh auth token`
# Live values: project .env or ~/.reasonix/.env (never commit). CI: Actions GITHUB_TOKEN.
# GITHUB_TOKEN=ghp_…
# GITHUB_ACCESS_TOKEN=
# GH_TOKEN=
# GITHUB_API_DOMAIN=api.github.com
#
# bun-pr (oven-sh/bun PR release builds) — primary auth is `gh auth login`
#   bunx bun-pr <pr-number|branch|PR-URL>
# GITHUB_TOKEN / GH_TOKEN / `gh auth token` satisfy artifact download.
# Optional Bun-upstream only: BUILDKITE_API_TOKEN — oven-sh/bun ci:status|errors|…
# via `bk` (brew install buildkite/buildkite/bk). Not FactoryWager; no Pass path.
# Map: docs/harness/tenants/bun-upstream-contributing.md
# https://bun.com/docs/project/contributing#download-release-build-from-pull-requests

# R2
# Channel / outbox / telegram consumer plane (Pages REGISTRY_BUCKET twin):
R2_REGISTRY_BUCKET=factory-wager-registry
# Bench / wiki cascade (r2BucketFromEnv) — do NOT point outbox here:
R2_BUCKET=bun-docs-prod
R2_BUCKET_NAME=factory-wager-wiki
R2_BENCH_PREFIX=reports/search-bench
R2_ENDPOINT=https://7a470541a704caaf91e71efccc78fd36.r2.cloudflarestorage.com
# Optional overlays (defaults from CLOUDFLARE_DEFAULTS / r2BucketUrlFromEnv)
# R2_BUCKET_URL=https://7a470541a704caaf91e71efccc78fd36.r2.cloudflarestorage.com/factory-wager-registry
REGISTRY_URL=https://registry.factory-wager.com

# Pages dashboard pins only (production + preview; separate from local packageManager)
BUN_VERSION=1.4.0
SKIP_DEPENDENCY_INSTALL=true

# ----------------------------------------------------------------------------
# Unknown long-option guards (docs:refid CLI allowlists)
# Allowlists live in code: lib/docs/ref-id-tool-flags.ts → ALLOWED_LONG_REGISTRY
# Do NOT put flag allowlist JSON in env — toggles only.
# ----------------------------------------------------------------------------
# Default (unset / false): unknown --flags → hard fail (exit 2 / throw)
# Set true locally to strip unknowns and continue (warn when BUN_LOG_UNKNOWN≠false)
BUN_STRIP_UNKNOWN=false
# Log a warning when stripping unknowns (default on when unset)
BUN_LOG_UNKNOWN=true

WIKI_BASE_URL=https://wiki.factory-wager.com
WIKI_DEPLOY_PATH=/path/to/wiki/index.html

# Documentation Settings
BUN_DOCS_CACHE_TTL=86400000  # 24 hours
BUN_DOCS_OFFLINE_MODE=false
BUN_DOCS_UPDATE_FREQUENCY=3600000  # 1 hour

# RSS Feed Configuration
RSS_UPDATE_INTERVAL=300000  # 5 minutes
RSS_MAX_FEEDS=50

# Package Settings
PACKAGE_DOCS_DIR=./docs
PACKAGE_RSS_FEED=true

# Server Configuration
DOCS_SERVER_PORT=3000
DOCS_SERVER_HOST=localhost

# Portal / Pages verification probes (optional overrides)
# PORTAL_VERIFY_BASE=http://127.0.0.1:3000
# PAGES_VERIFY_BASE=https://project-r-score.pages.dev
# Domain sweep fetch origins must be http(s) origins; an explicit URL port is preserved.
# DOMAIN_SWEEP_PAGES_BASE_URL=http://127.0.0.1:3000
# DOMAIN_SWEEP_SCORE_BASE_URL=https://score.factory-wager.com
# DOMAIN_SWEEP_FETCH_TIMEOUT_MS=12000
# DOMAIN_SWEEP_GATE_TIMEOUT_MS=180000
# BUN_PORT / PORT / NODE_PORT are Bun.serve defaults, not client fetch URL overrides.

# ============================================================================
# Payment Webhook Server Configuration
# ============================================================================

# Server (use different port from main server to avoid conflict)
PAYMENT_SERVER_PORT=3001
REDIS_URL=redis://localhost:6379

# PayPal Webhook Configuration
# Get webhook ID from PayPal Developer Dashboard → Webhooks
PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret

# DOD visual-proof HMAC (fail-closed in production — lib/security/require-secret.ts)
DOD_PROOF_SECRET=
# Play-signing HMAC (fail-closed in production)
PLAY_SIGNING_SECRET=

# Venmo Webhook Configuration
# Get from Venmo Developer Portal
VENMO_WEBHOOK_SECRET=your_venmo_webhook_secret

# Risk Assessment Thresholds (optional, defaults shown)
# RISK_LOW_SCORE_MIN=0.95     # Auto-approve if score > this
# RISK_LOW_DRIFT_MAX=0.01     # Auto-approve if drift < this
# RISK_HIGH_DRIFT_MIN=0.05    # Block if drift > this

# Search Domain Registry defaults
DOMAIN_REGISTRY_PATH=.search/domain-registry.json
SEARCH_BENCH_DOMAIN=factory-wager.com
FACTORY_WAGER_REQUIRED_HEADER=x-factory-domain-token

# CORS (comma-separated allowed origins, empty = allow all)
CORS_ALLOWED_ORIGINS=

# Per-domain token scaffolding (replace before use)
FACTORY_WAGER_TOKEN_ROOT=replace_me
FACTORY_WAGER_TOKEN_REGISTRY=replace_me
FACTORY_WAGER_TOKEN_API=replace_me
FACTORY_WAGER_TOKEN_CDN=replace_me
FACTORY_WAGER_TOKEN_MONITOR=replace_me
FACTORY_WAGER_TOKEN_DOCS=replace_me
FACTORY_WAGER_TOKEN_RSS=replace_me
FACTORY_WAGER_TOKEN_CONFIG=replace_me
FACTORY_WAGER_TOKEN_ADMIN=replace_me
FACTORY_WAGER_TOKEN_AUTH=replace_me
FACTORY_WAGER_TOKEN_DATABASE=replace_me
FACTORY_WAGER_TOKEN_STORAGE=replace_me
FACTORY_WAGER_TOKEN_VAULT=replace_me
FACTORY_WAGER_TOKEN_REDIS=replace_me
FACTORY_WAGER_TOKEN_WWW=replace_me
FACTORY_WAGER_TOKEN_BLOG=replace_me
FACTORY_WAGER_TOKEN_SUPPORT=replace_me
FACTORY_WAGER_TOKEN_WIKI=replace_me

# Console/object-inspection depth for tools (Bun native: bun --console-depth=N, Bun.inspect({depth}))
# SSOT: bunfig.toml [console] depth = 6 (drives console.log and wrappers when this override is unset).
# BUN_CONSOLE_DEPTH is a repo-local override read ONLY by the wrappers (the Bun runtime ignores it).
# Precedence: explicit depth option > --console-depth=N flag > this env > bunfig depth > Bun default (2).
# Accepted wrapper range: whole integers from 0 through 65535.
# BUN_CONSOLE_DEPTH=4

# ============================================================================
# Telegram — factory bot (SSOT: lib/telegram/telegram-config.ts)
# Docs: docs/harness/tenants/telegram-factory.md
# Verify: bun run telegram:verify · Setup: bun run telegram:factory:setup
# ============================================================================

# Factory tenant bot (@factorywager_bot) — config/tenants.ts telegramBotEnvKey
TELEGRAM_BOT_FACTORY=
# Legacy alias (monitoring.json still references TELEGRAM_BOT_TOKEN)
# TELEGRAM_BOT_TOKEN=

# Webhook secret for Pages /api/telegram/webhook/factory (optional)
# TELEGRAM_WEBHOOK_SECRET=

# Supergroup chat for ops/alerts projector when payload has no telegramId
# TELEGRAM_OPS_CHAT_ID=-100xxxxxxxxxx
# Cross-partner accounting proof rollup (forum: Deposits · Withdrawals · Reconcile)
# TELEGRAM_ACCOUNTING_CHAT_ID=-100xxxxxxxxxx
# Concern → chat_id map (hq | all-accounting | ash-staging | sandbox) — see lib/telegram/surfaces.ts
# TELEGRAM_SURFACES={"hq":"-100…","all-accounting":"-100…","ash-staging":"-100…","sandbox":"-100…"}
# Comma-separated Telegram user ids for sensitive in-chat ops (optional)
# OPS_ADMIN_USER_IDS=123456789,987654321

# Forum topic threads — JSON map logical name → message_thread_id
# TELEGRAM_TOPICS={"ops":2,"alerts":5,"toc":8,"plays":3}

# Min ms between sendMessage calls per token (~29/s default; Telegram limit ~30/s)
# TELEGRAM_RATE_LIMIT_MIN_INTERVAL_MS=34

# Partner Ledger Validation
# Comma-separated allowed proof URL prefixes (validate:ledger). Default: the
# artifact-registry proofs base. OPERATIONS_DB_PATH overrides the ops DB path.
ALLOWED_PROOF_DOMAINS=https://registry.factory-wager.com/api/registry/proofs/
# OPERATIONS_DB_PATH=data/operations.db

# ============================================================================
# Concept audit — bun run concept:audit (scripts/concept-audit.ts)
# CLI flags override env. AND across filter types; OR within comma lists.
# Docs: docs/harness/tenants/partner-limits.md · partners:governance uses --strict
# ============================================================================
# CONCEPT_WATCH_PATHS=lib/portal/semantic-vocabulary.ts,scripts/concept-metadata-baseline.json,public/portal
# CONCEPT_AUDIT_STRICT=0
# CONCEPT_AUDIT_QUIET=0
# CONCEPT_AUDIT_OUTPUT=table
# CONCEPT_AUDIT_FILTER=active
# CONCEPT_AUDIT_GROUP=ops.metric,ops.filter
# CONCEPT_AUDIT_CATEGORY=ui
# CONCEPT_AUDIT_BOARD=partner-history
# CONCEPT_AUDIT_SORT=usage
# CONCEPT_AUDIT_DESC=1
# CONCEPT_AUDIT_SHOW_UNUSED=0
# CONCEPT_AUDIT_SHOW_USED=0
# CONCEPT_AUDIT_SHOW_DEPRECATED=0
# CONCEPT_AUDIT_SHOW_ORPHANS=0
# CONCEPT_AUDIT_MIN_USAGE=0
# CONCEPT_AUDIT_MAX_USAGE=9999
# CONCEPT_AUDIT_PROVENANCE=
# CONCEPT_AUDIT_OUTPUT_HEADERS=id,label,group,category,status,provenance,usage
# CONCEPT_AUDIT_WATCH_POLL=0
# CONCEPT_AUDIT_WATCH_DELAY_MS=200
# CONCEPT_AUDIT_VERBOSE=0
