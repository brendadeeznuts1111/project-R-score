# .env.example

# Bun install — machine SSOT: ~/.bunfig.toml [install.cache].dir
# Do not set BUN_INSTALL_CACHE_DIR or BUN_INSTALL_GLOBAL_STORE in .env

# ============================================================================
# Cloudflare / R2 / Pages — SSOT: config/r2-env.ts (CLOUDFLARE_DEFAULTS)
# Status: bun run cloudflare:env · Tenant: docs/harness/tenants/cloudflare-pages.md
# ============================================================================

# Account + zone (non-secret). R2_* and CLOUDFLARE_* both kept — callers differ.
CLOUDFLARE_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
R2_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
CLOUDFLARE_ZONE_ID=a3b7ba4bb62cb1b177b04b8675250674
CLOUDFLARE_ZONE_NAME=factory-wager.com

# Secrets (never commit real values). Local: wrangler login. CI: API token.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2
R2_BUCKET=bun-docs-prod
R2_BUCKET_NAME=factory-wager-wiki
R2_REGISTRY_BUCKET=npm-registry
R2_BENCH_PREFIX=reports/search-bench
R2_ENDPOINT=https://7a470541a704caaf91e71efccc78fd36.r2.cloudflarestorage.com
# Optional overlays (defaults from CLOUDFLARE_DEFAULTS / r2BucketUrlFromEnv)
# R2_BUCKET_URL=https://7a470541a704caaf91e71efccc78fd36.r2.cloudflarestorage.com/factory-wager-registry
# Bun ≥1.3.6 S3 Requester Pays (usually off for R2 owner-billed buckets)
# R2_REQUEST_PAYER=false
REGISTRY_URL=https://registry.factory-wager.com

# Pages dashboard pins only (NOT local packageManager — canary 1.4.0 404s on Pages)
BUN_VERSION=1.3.14
SKIP_DEPENDENCY_INSTALL=true

WIKI_BASE_URL=https://wiki.factory-wager.com
WIKI_DEPLOY_PATH=/path/to/wiki/index.html

# Documentation Settings
BUN_DOCS_CACHE_TTL=86400000  # 24 hours
BUN_DOCS_OFFLINE_MODE=false
BUN_DOCS_UPDATE_FREQUENCY=3600000  # 1 hour

# RSS Feed Configuration
RSS_UPDATE_INTERVAL=300000  # 5 minutes
RSS_MAX_FEEDS=50

# Package Settings
PACKAGE_DOCS_DIR=./docs
PACKAGE_RSS_FEED=true

# Server Configuration
DOCS_SERVER_PORT=3000
DOCS_SERVER_HOST=localhost

# ============================================================================
# Payment Webhook Server Configuration
# ============================================================================

# Server (use different port from main server to avoid conflict)
PAYMENT_SERVER_PORT=3001
REDIS_URL=redis://localhost:6379

# Pinecone (Super-Profile Vector Database)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=super-profiles
PINECONE_DIM=384

# PayPal Webhook Configuration
# Get webhook ID from PayPal Developer Dashboard → Webhooks
PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_secret

# Venmo Webhook Configuration
# Get from Venmo Developer Portal
VENMO_WEBHOOK_SECRET=your_venmo_webhook_secret

# Risk Assessment Thresholds (optional, defaults shown)
# RISK_LOW_SCORE_MIN=0.95     # Auto-approve if score > this
# RISK_LOW_DRIFT_MAX=0.01     # Auto-approve if drift < this
# RISK_HIGH_DRIFT_MIN=0.05    # Block if drift > this

# Search Domain Registry defaults
DOMAIN_REGISTRY_PATH=.search/domain-registry.json
SEARCH_BENCH_DOMAIN=factory-wager.com
FACTORY_WAGER_REQUIRED_HEADER=x-factory-domain-token

# CORS (comma-separated allowed origins, empty = allow all)
CORS_ALLOWED_ORIGINS=

# Per-domain token scaffolding (replace before use)
FACTORY_WAGER_TOKEN_ROOT=replace_me
FACTORY_WAGER_TOKEN_REGISTRY=replace_me
FACTORY_WAGER_TOKEN_API=replace_me
FACTORY_WAGER_TOKEN_CDN=replace_me
FACTORY_WAGER_TOKEN_MONITOR=replace_me
FACTORY_WAGER_TOKEN_DOCS=replace_me
FACTORY_WAGER_TOKEN_RSS=replace_me
FACTORY_WAGER_TOKEN_CONFIG=replace_me
FACTORY_WAGER_TOKEN_ADMIN=replace_me
FACTORY_WAGER_TOKEN_AUTH=replace_me
FACTORY_WAGER_TOKEN_DATABASE=replace_me
FACTORY_WAGER_TOKEN_STORAGE=replace_me
FACTORY_WAGER_TOKEN_VAULT=replace_me
FACTORY_WAGER_TOKEN_REDIS=replace_me
FACTORY_WAGER_TOKEN_WWW=replace_me
FACTORY_WAGER_TOKEN_BLOG=replace_me
FACTORY_WAGER_TOKEN_SUPPORT=replace_me
FACTORY_WAGER_TOKEN_WIKI=replace_me

# Console/object-inspection depth for tools (Bun native: bun --console-depth=N, Bun.inspect({depth}))
# Consumed by lib/console-depth.ts; CLI flag --console-depth=N overrides, this overrides the default (4).
BUN_CONSOLE_DEPTH=4
