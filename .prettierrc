{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "insertPragma": false,
  "proseWrap": "preserve",
  "requirePragma": false,
  "htmlWhitespaceSensitivity": "css",
  "vueIndentScriptAndStyle": false,
  "singleAttributePerLine": false,
  "overrides": [
    {
      "files": ["*.{ts,tsx,js,jsx,mjs,cjs}"],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "singleQuote": true,
        "arrowParens": "avoid"
      }
    },
    {
      "files": ["*.{test,spec}.{ts,tsx,js,jsx}"],
      "options": {
        "printWidth": 100,
        "tabWidth": 2
      }
    },
    {
      "files": ["*.{md,mdx}"],
      "options": {
        "printWidth": 80,
        "proseWrap": "always",
        "tabWidth": 2
      }
    },
    {
      "files": ["*.{json,jsonc}"],
      "options": {
        "printWidth": 80,
        "tabWidth": 2
      }
    },
    {
      "files": ["*.{yml,yaml}"],
      "options": {
        "printWidth": 80,
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": ["*.{css,scss,less}"],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": ["*.{html,htm,vue,svelte,astro}"],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "htmlWhitespaceSensitivity": "css"
      }
    },
    {
      "files": ["*.{toml,ini,cfg}"],
      "options": {
        "printWidth": 80,
        "tabWidth": 2
      }
    },
    {
      "files": ["*.{graphql,gql}"],
      "options": {
        "printWidth": 80,
        "tabWidth": 2
      }
    },
    {
      "files": ["*.{lock,lockb}"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": [
        "package.json",
        "tsconfig*.json",
        "jsconfig*.json",
        ".mcp.json",
        ".cursor/mcp.json",
        "bunfig.toml"
      ],
      "options": {
        "printWidth": 80,
        "tabWidth": 2
      }
    },
    {
      "files": [".prettierrc", ".editorconfig", ".gitignore", ".prettierignore", ".eslintignore"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.{config,setup}.{ts,js,mjs,cjs}"],
      "options": {
        "printWidth": 100,
        "tabWidth": 2
      }
    }
  ]
}
